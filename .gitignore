# Dependencies
node_modules/
frontend/node_modules/
vendor/

# Next.js build output
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo

# Playwright's own output: a run's traces and its HTML report. Both are
# artefacts of a failure, useful on the machine that produced them.
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/

# Documentation site build output (published from CI, never committed)

# Local environment overrides
.env
.env.local
.env.*.local

# OS / Editor files
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Хөгжүүлэгчийн машин дээрх кодын туслахуудын тохиргоо. Хүн бүр өөр хэрэгсэл,
# өөр тохиргоотой ажилладаг тул түүхэнд хэрэггүй.
.qwen/

# Go / Binary outputs
bin/
tmp/
*.exe
*.dll
*.so
*.dylib
*.node

# Logs & Coverage
*.log
coverage.out
coverage.html

# Xcode-ийн хэрэглэгчийн төлөв — машин бүрт өөр, түүхэнд хэрэггүй.
xcuserdata/
*.xcuserstate
native-apps/desktop/macos/build/
native-apps/desktop/macos/NexusGeregeDesktop
# .xcodeproj нь project.yml-ээс ҮҮСГЭГДДЭГ артефакт — build.sh бүрд шинэчлэгдэнэ.
native-apps/desktop/macos/NexusGeregeDesktop.xcodeproj/
native-apps/mobile/ios/NexusGeregeMobile.xcodeproj/
native-apps/desktop/gerege-token-kit/.build/
native-apps/mobile/android/**/build/
native-apps/mobile/android/.gradle/
native-apps/mobile/android/local.properties
native-apps/mobile/ios/.build/
native-apps/mobile/ios/.swiftpm/
native-apps/desktop/windows/**/bin/
native-apps/desktop/windows/**/obj/

# Next.js build output for the store and console services
services/*/.next/
services/*/node_modules/
__pycache__/
