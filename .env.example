# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/platform_db?sslmode=disable
PORT=8080

# Redis carries cache invalidation between API replicas and holds the
# deployment-wide rate-limit counters. It stores no values and no sessions, so
# losing it loses nothing a user can see.
#
# Leave it empty and the platform behaves as it did before Redis existed:
# invalidation stays inside the process and every replica counts its own rate
# limits. That is correct with one replica and wrong with more — two replicas
# give a caller twice the login budget, and a permission revoked on one is
# still honoured by the other until its copy expires.
REDIS_URL=redis://localhost:6379/0

# Where a verification link may return somebody after they have proved their
# address. PUBLIC_ORIGIN is always allowed; list any additional hostnames here,
# comma-separated. Exact matches only — a subdomain does not inherit trust.
#
# Without this the platform would forward whoever clicks the link wherever the
# caller asked, over its own name, in a mail the recipient was told to trust.
EMAIL_VERIFY_REDIRECT_HOSTS=

# How long a session may go unused before it stops working, on top of the
# twelve-hour absolute lifetime. A Go duration ("45m", "2h"); 0 turns it off.
#
# This — and CATALOG_SYNC_INTERVAL and GEMINI_MODEL — is now also a platform
# setting, editable in the operator console without a deploy. The order is
# console value → this variable → the built-in default, so a deployment that
# only sets this behaves exactly as it always has (docs/CONTROL_PLANE.md §4ё).
# The default is deliberately generous — a desktop client left open on a second
# monitor is idle for long stretches and must not be signed out for it.
SESSION_IDLE_TIMEOUT=90m

# The hostname the operator console answers on — see docs/CONTROL_PLANE.md.
#
# Unset in production means the console is off entirely, which is the safe
# reading of a variable nobody has set: the alternative would put an
# administration interface on the hostname every tenant already uses. Unset on
# a development machine leaves it open at http://localhost:3000/cp, because
# there is no separate hostname to give it there.
#
# It is not enough on its own. The console must also sit behind nginx's
# address allowlist (deploy/nginx/snippets/cp-allowlist.conf); this variable is
# the second layer, not the first.
CONTROL_PLANE_HOST=

# The operator console's front page reads these. All optional; unset means the
# console shows the panels that come from the database and says the rest is not
# configured (docs/CONTROL_PLANE.md §4з).
PROMETHEUS_URL=
ALERTMANAGER_URL=
GRAFANA_URL=

# The deploy button asks GitHub to run the deployment workflow. The token must
# be a fine-grained one scoped to that workflow and nothing else.
GITHUB_DEPLOY_TOKEN=
GITHUB_REPOSITORY=
GITHUB_DEPLOY_WORKFLOW=deploy.yml

# development | staging | production.
# "production" hardens several defaults: secure cookies, no mock national
# integrations, no demo data seeding.
ENVIRONMENT=development

# Path to the app-store catalog read at boot (manifests live next to it).
APP_CATALOG_PATH=catalog/apps.json

# ─── App registry (optional) ─────────────────────────────────────────────────
# Where the app catalog comes from, when it does not come from the file above.
#
# Leave APP_CATALOG_URL empty and nothing below applies: the catalog is the file
# that shipped with this release, which is the whole story for a self-hosted
# deployment and the default this platform has always had. Setting it adds two
# sources in front of that file rather than replacing it —
#
#   registry  → signed, fetched with an ETag
#   cache     → the last signed answer this instance accepted
#   file      → catalog/apps.json, always there
#
# — so an unreachable, slow or broken registry costs an instance its updates and
# nothing else. Boot never fails because of it, and apps a tenant has already
# installed do not depend on it at all.
APP_CATALOG_URL=
#
# The registry's Ed25519 public key, base64. A remote catalog is NEVER used
# without one, and one that does not verify is discarded rather than read: a
# catalog decides what code a tenant is offered, so a compromised or
# impersonated registry must not be able to hand this instance a manifest of its
# choosing. With APP_CATALOG_URL set and this empty, the instance stays on its
# file and says so at startup.
APPSTORE_PUBLIC_KEY=
#
# Where the last accepted catalog is kept, so a restart while the registry is
# down serves what this instance was serving rather than what the release
# shipped with. It is re-verified on the way back in — the file sits on disk
# between two boots, and whatever could edit it could also have written it.
CATALOG_CACHE_PATH=/var/lib/nexus/catalog.cache.json
#
# How often the background refresh runs (a Go duration). A catalog changes when
# a publisher publishes, so polling harder buys nothing; anything under a minute
# is treated as a minute. An administrator who has been told a new version
# exists does not have to wait for it: POST /api/v1/admin/store/sync runs one
# round on demand.
CATALOG_SYNC_INTERVAL=1h
#
# Which publication channel this instance follows. "stable" unless you mean it.
APP_CATALOG_CHANNEL=stable
#
# What this deployment is to the registry, issued by the App Store.
#
# It answers a question the signature cannot. A signature says who wrote the
# catalog; it says nothing about who should be reading it, and both matter once
# an app is published to named platforms rather than to all of them. A request
# without this is anonymous, and an anonymous request can only be answered with
# what every platform may see.
#
# Empty is the normal case and is not a degradation: a deployment that has been
# granted no private apps has nothing to prove. Set it only when the App Store
# has issued one for this platform.
#
# Sent as an Authorization header, never on the query string, and never written
# to the catalog cache — the cache holds the answer, and an answer is not a
# credential.
APP_CATALOG_TOKEN=

# Comma-separated CORS allow-list. Defaults to localhost:3000 when unset.
#
# In production this also carries the device domain lines
# (mac./win./ios./android./kiosk./pos.) — see deploy/.env.prod.example. Locally
# every native client points at this same localhost:3000, so there is nothing
# extra to list; the lines only separate once there are real hostnames.
ALLOWED_ORIGINS=http://localhost:3000

# The publishing console at developer.gerege.mn, if this deployment has one.
#
# Setting the origin registers an OAuth2 client for it at startup: public, with
# PKCE and one redirect URI, ${DEVELOPER_CONSOLE_ORIGIN}/auth/callback. A client
# a console cannot work without should not depend on somebody remembering to
# create it by hand, and a redirect URI typed into a form is one that can be
# typed wrongly. Leave it empty and nothing is registered.
#
# The console never calls this API from a browser — it exchanges the code on its
# own server — so it does not belong in ALLOWED_ORIGINS.
DEVELOPER_CONSOLE_ORIGIN=
DEVELOPER_CONSOLE_CLIENT_ID=gerege-developer-console

# Set to true only when the API sits behind a proxy you control; otherwise
# X-Forwarded-For is attacker-controlled and defeats the login rate limiter.
TRUST_PROXY_HEADERS=false

# Creates the documented demo account (admin@example.com / Password123!).
# Defaults to on outside production.
SEED_DEMO_DATA=true

# ─── Brand ───────────────────────────────────────────────────────────────────
# What this deployment calls itself. Read by both halves — the API for the two
# sentences it puts in front of a person, the browser app for everything else:
# the document title, the installed app's name, the header, the sign-in screen,
# the consent screen, and every translated string that names the product.
#
# All of it is optional, and unset means Gerege Nexus. The variables exist so
# that one image can be deployed under another name without a rebuild, which is
# Level 1 of docs/ECOSYSTEM_GIT_STRATEGY.md; it is the same argument that took
# the deployment's address out of the build (frontend/lib/apiBase.ts).
#
# Set BRAND_NAME in both containers or in neither. A deployment that renames
# only one has a sign-in screen and an eID prompt disagreeing about which
# product the person is standing in front of.
BRAND_NAME=
# What a launcher has room for under an icon. Unset means BRAND_NAME.
BRAND_SHORT_NAME=
# One sentence, used as the page description and in the install prompt.
BRAND_DESCRIPTION=
# The mark, as a path served by this deployment or an absolute https URL. It is
# not a file this image can be given, so it is an address: put the logo behind
# the same proxy that serves the app, or on a host the browser can reach.
# Anything that is neither a path nor an http(s) URL is ignored.
BRAND_LOGO_URL=
# The browser and launcher chrome colour, as a CSS hex colour. This is the
# frame around the app, not the accent inside it — the palette people pick from
# in Appearance is theirs, per device, and stays that way.
BRAND_THEME_COLOR=
# The icon a tab, a home screen and an installed app use. Same rules as the
# logo: a path this deployment serves, or an absolute https URL.
#
# A different picture from the logo, doing a different job. The logo sits in a
# header beside a name at 36 pixels; this one stands alone at 512 on somebody's
# home screen and needs its own ground under it. A square PNG of at least 512
# is what an installable app wants; smaller works and is drawn soft.
#
# Empty keeps the icons this image was built with, which is the honest default:
# an icon set is files, and a deployment that has not supplied one has not got
# one.
BRAND_ICON_URL=
# The same icon drawn for a launcher that crops it — Android's adaptive icons
# cut a circle out of whatever they are given. This is not a resize: the artwork
# has to bleed to the edge with everything that matters inside a safe zone, so
# an ordinary square icon declared maskable comes out with its corners gone.
# Leave it empty unless you have artwork drawn for it; the launcher then crops
# the ordinary icon itself, which is visibly a crop rather than quietly wrong.
BRAND_MASKABLE_ICON_URL=

# The deployment's own wording, where a name is not the whole difference.
#
# Everything above renames a deployment. This one lets it say something
# different: a health platform's landing page does not describe itself the way
# the general platform does, and that difference is a paragraph in seven
# languages rather than a noun. Without this the only way to write it was to
# fork the repository — which is what Gerege Salus did, for about eighty lines
# of prose, and then had to be given every security fix twice.
#
# A JSON file of translation keys, each holding the languages this deployment
# wrote:
#
#   {
#     "website.view.hero_lede": { "mn": "…", "en": "…" },
#     "website.message.footer_note": { "en": "…" }
#   }
#
# Matched per key *and* per language: supplying English overrides English and
# leaves Mongolian reading as it did. A key nobody overrode is untouched, and a
# key that does not exist is ignored. Read once at startup, so a change takes
# effect on restart — the same moment BRAND_NAME would.
#
# The keys are the ones in frontend/lib/i18n/; `{brand}` still works inside an
# override. BRAND_COPY holds the same JSON inline for a deployment overriding a
# line or two; the file wins when both are set.
BRAND_COPY_FILE=
BRAND_COPY=

# Where this deployment's manual lives — the landing page's last menu item.
# Empty keeps the platform's own book, which describes the platform rather than
# this deployment; a distribution that has written its own says so here.
# Where the shell reaches the API from the server side, before a page is sent.
# The browser never uses it: it asks its own origin. Empty is the right answer
# for a stack laid out like docker-compose.prod.yml — the default points at the
# backend service beside it. Name it only if the API lives somewhere else.
API_INTERNAL_URL=

BRAND_DOCS_URL=

# Which sections the landing page is built from, and in what order. Comma or
# space separated, from:
#
#   hero  architecture  applications  platform  trust  technology  capabilities
#
# Empty renders all seven, in that order — what every deployment did before this
# existed. Naming a subset is for the deployment whose page is making a shorter
# argument: an identity provider has no catalogue of business applications to
# show, and rewriting that section's prose does not help when the honest answer
# is that it does not apply. The menu follows: a section left out takes its menu
# item with it.
LANDING_SECTIONS=

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ─── Gemini AI pipeline ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore

# ─── MinIO / Object Storage ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword

# ─── OAuth2 / OIDC provider ──────────────────────────────────────────────────
SSO_ISSUER=http://localhost:8080
# Secret for the built-in "gerege-dev-portal" client. Required in production;
# outside production a random one is generated and logged at startup.
SSO_DEFAULT_CLIENT_SECRET=
# Which tenant owns that built-in client. Clients are tenant-owned, so one with
# no owner would be invisible in every developer portal and impossible to
# rotate; if this tenant does not exist, the client is skipped rather than
# created ownerless.
SSO_DEFAULT_CLIENT_TENANT=demo
# Deployment-wide allowlist for redirect URI hosts, comma-separated and matched
# exactly — subdomains do not inherit trust. Defaults to nexus.gerege.mn.
# Loopback callbacks are always allowed, for installed development clients.
#
# It governs the post-logout addresses too: both are places this platform sends
# a browser on a client's say-so, so both answer to the same list.
OAUTH_REDIRECT_HOSTS=

# ─── Google sign-in ──────────────────────────────────────────────────────────
#
# Adds a "Google-ээр нэвтрэх" button beside eID on this platform's own sign-in
# screen. It is an extra way in, not a replacement: unlike SSO_CLIENT_ISSUER
# below, it closes nothing.
#
# Deliberately separate from the GOOGLE_OAUTH_CLIENT_ID that the Drive and Meet
# connectors use. The same Google project usually issues both, and they may hold
# the same value — but that has to be the operator's explicit act, because
# inheriting a sign-in path from a document connector would mean enabling the
# connector quietly opened a new front door.
#
# At Google, register the redirect URI ${SSO_ISSUER}/api/v1/auth/google/callback.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Defaults to ${SSO_ISSUER}/api/v1/auth/google/callback. Set it in development,
# where the API and the browser app sit on different ports.
GOOGLE_LOGIN_REDIRECT_URI=
# Which organisation somebody Google vouches for but this deployment has never
# seen is created in. Empty — the default — provisions nobody: a Google identity
# then only reaches an account that already exists here, matched on its verified
# address. Set this and anybody with a Google account can obtain one, so set the
# domain list below with it.
GOOGLE_LOGIN_TENANT=
# Comma-separated email domains allowed to sign in with Google ("gerege.mn,
# dgov.mn"). Empty means the domain is not the check — which is safe only
# because provisioning is off by default.
GOOGLE_LOGIN_ALLOWED_DOMAINS=

# ─── SSO client: signing in through another provider ─────────────────────────
#
# Everything above makes this deployment an identity *provider*. This section is
# the other half: it makes the deployment a *client* of one — including of
# another Gerege Nexus. The two are independent, and a deployment can be both.
#
# Setting SSO_CLIENT_ISSUER is the switch. From then on this deployment does not
# authenticate anybody itself: its password, eID and DAN sign-in endpoints stop
# answering, the login screen becomes a hand-off to the provider, and signing
# out here signs the person out there and brings them back.
#
# Leave it empty — the default — and nothing below matters.
#
# See docs/SSO_FEDERATION.md for what to register at the provider.
SSO_CLIENT_ISSUER=
# The client this deployment was registered as at that provider. Required as
# soon as the issuer is set; the server refuses to start without it, rather than
# quietly falling back to its own login screen.
SSO_CLIENT_ID=
# Empty registers this as a public client, proving the exchange with PKCE alone.
# A deployment is a server and can keep a secret, so set one if the provider
# issued one.
SSO_CLIENT_SECRET=
# What the sign-in screen calls the provider. Cosmetic; the issuer's hostname is
# used when it is empty.
SSO_CLIENT_PROVIDER_NAME=
# Defaults to "openid profile email". openid is added whether or not it is
# listed: without it no id_token comes back and there is nothing to verify.
SSO_CLIENT_SCOPES=
# The callback registered at the provider. Defaults to
# ${SSO_ISSUER}/api/v1/auth/sso/callback, which is right in production; in
# development the API and the browser app are on different ports, so set it
# explicitly to the API's.
SSO_CLIENT_REDIRECT_URI=
# Where the provider returns somebody after signing them out, registered there
# as this client's post_logout_redirect_uri. Defaults to ${SSO_ISSUER}/.
SSO_CLIENT_POST_LOGOUT_REDIRECT_URI=
# The organisation somebody the provider vouches for but this deployment has
# never seen is created in. Empty — the default — provisions nobody: a verified
# stranger is refused, which is what a deployment whose membership is managed
# deliberately wants.
SSO_CLIENT_TENANT=
# Keeps this deployment's own password and eID sign-in working alongside the
# provider's. Off by default, because two front doors is not federation. Turn it
# on to get back in when the provider is the thing that is broken.
SSO_CLIENT_LOCAL_LOGIN=false

# ─── National integrations (E-ID, DAN, XYP) ──────────────────────────────────
# Mock mode returns canned identities and must never be implicit in production.
# Unset = enabled outside production, disabled in production.
EID_MOCK_MODE=true
DAN_MOCK_MODE=true
XYP_MOCK_MODE=true

EID_CLIENT_ID=
EID_CLIENT_SECRET=
# eID Mongolia relying-party credentials. The callback registered with eID
# should be ${PUBLIC_ORIGIN}/auth/eid/callback.
EID_BASE_URL=https://eidmongolia.mn/v3
EID_RP_UUID=
EID_RP_SECRET=
EID_RP_NAME=Gerege Nexus
EID_CERT_LEVEL=ADVANCED
EID_DISPLAY_TEXT=Gerege Nexus-д нэвтрэх
# Optional tenant slug for verified eID identities that have no existing
# Gerege Nexus account. New memberships receive the standard user role, never admin.
EID_JIT_TENANT_SLUG=

# eID Mongolia qualified remote signing (PDF E-Sign app). It reuses the relying
# party identity above — one RP registration carries both the authentication and
# the SIGNATURE permission — and layers signing-specific overrides on top.
#
# Mock mode serves canned ceremonies so the screens work without an RP
# registration. A document "signed" in mock mode carries no PKCS#7, no
# certificate chain and no revocation data: it is a demo artefact, not a legally
# valid signature. Never leave this on in production.
EID_SIGN_MOCK_MODE=true
# Defaults to EID_BASE_URL, then https://eidmongolia.mn/v3.
EID_SIGN_BASE_URL=
# The minimum certificate level accepted for a signature. QUALIFIED is what
# Mongolian law means by "тоон гарын үсэг"; accepting ADVANCED here would
# silently downgrade every document the platform produces.
EID_SIGN_CERT_LEVEL=QUALIFIED
# Shown on the phone above the PIN2 prompt (60 characters). Left empty, each
# ceremony names the document being signed, which is more useful.
EID_SIGN_DISPLAY_TEXT=

# Gerege eSign HSM (the older PDF signing rail). The key lives in the operator's
# HSM rather than with the citizen, so this does not produce a qualified
# signature; a tenant can disable it entirely from the signing policy screen.
ESIGN_MOCK_MODE=true
ESIGN_LOGIN_URL=https://hsm.gerege.mn/esign/login
ESIGN_SIGN_URL=https://hsm.gerege.mn/signer/signpdf
# Basic credential for the eSign service. Never returned to a browser.
ESIGN_TOKEN=
DAN_ENDPOINT=https://dan.gerege.mn/api/v1
DAN_API_KEY=
XYP_ENDPOINT=https://xyp.gerege.mn/api/v1
XYP_API_KEY=

# ─── Integration connectors ──────────────────────────────────────────────────
# Tenants connect Google Drive, Dropbox and Google Meet from
# Settings → Integrations. Two things have to be in place first.
#
# 1. A key to seal credentials with. Webhook signing secrets and OAuth refresh
#    tokens are AES-256-GCM encrypted before they touch the database, so a dump
#    is not a set of working credentials for somebody's Drive. Without this the
#    server refuses to store a credential rather than storing it in the clear —
#    the connector cannot be saved, which is the failure you can see and fix.
#
#    Generate one with:  openssl rand -base64 32
#    Rotating it makes every stored credential unreadable; tenants have to
#    reconnect. There is no re-encryption pass.
INTEGRATION_ENCRYPTION_KEY=
#
# 2. An OAuth client per provider, registered by whoever operates this
#    deployment — not per tenant. The consent screen belongs to this platform,
#    and asking every tenant administrator to create a Google Cloud project is
#    not a product.
#
#    The redirect URI to register with both providers is exactly:
#      $PUBLIC_ORIGIN/api/v1/integrations/oauth/callback
#    It is derived from PUBLIC_ORIGIN rather than from the incoming request, so
#    a forged Host header cannot point the callback — and the authorization
#    code with it — somewhere else. Register it verbatim or the exchange fails
#    with redirect_uri_mismatch.
#
#    Google (console.cloud.google.com → APIs & Services → Credentials).
#    Enable the Drive API for the Drive connector and the Calendar API for the
#    Meet connector: a Meet link is issued by Calendar through
#    conferenceData.createRequest — there is no standalone Meet API — so a Meet
#    connector without the Calendar API enabled fails at the moment a citizen
#    is waiting for a link. Scopes requested: drive.file (files this app
#    creates, not the rest of the account) and calendar.events.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#
#    Dropbox (dropbox.com/developers/apps → Create app → Scoped access).
#    "App folder" access type is the narrower choice and the one to prefer:
#    everything the platform writes stays under /Apps/<app name>/, the same way
#    drive.file keeps Drive to the files this application created.
#    Tick these three permissions — one per endpoint this platform calls:
#      files.content.write   upload the document
#      account_info.read     name the connected account in the UI
#      sharing.write         the shared link recorded against the delivery
#    A missing scope does not fail the upload; Dropbox refuses only the call
#    that needed it, so the file lands and the link silently never appears.
DROPBOX_OAUTH_CLIENT_ID=
DROPBOX_OAUTH_CLIENT_SECRET=
#
# 3. Optional, and off unless you mean it.
#
#    A webhook or REST connector is an address a tenant administrator types in,
#    and this server is what connects to it — from inside your network. Left
#    open, that is a way to have the platform fetch
#    http://169.254.169.254/latest/meta-data/ and report the answer back on the
#    settings screen. So loopback, private, link-local and reserved addresses
#    are refused, both when the connector is saved and again when the socket is
#    opened — the second check is the one that holds, because a hostname
#    resolves later and a redirect can land anywhere.
#
#    Set this only for a self-hosted deployment whose subscribers genuinely
#    live on the same private network. It disables the guard for every
#    connector in the process, not for one.
INTEGRATION_ALLOW_PRIVATE_TARGETS=false

# ─── Open Gerege RP-API ──────────────────────────────────────────────────────
# Relying Party credentials issued at registration. The secret is shown once —
# keep it in your local .env (git-ignored) or a secret manager, never in git.
# Calls send it as: Authorization: Bearer $RP_API_SECRET
RP_API_UUID=
RP_API_SECRET=

# ─── Email verification ──────────────────────────────────────────────────────
# Proving an address is done through a hosted service, not by this platform.
# Delivering mail that arrives is not a matter of holding an SMTP password: it
# is SPF, DKIM, DMARC, reverse DNS and a sending reputation, maintained
# continuously. So the platform asks the service for a link, holds no mailbox
# credential, composes no message and owns no sender address.
#
# The key is a server-side secret. It must never reach a browser or a repository
# — anyone holding it can send mail in this platform's name. Keys are issued and
# revoked at https://admin.enigma.mn; revoking one takes effect immediately.
EMAIL_VERIFY_API_KEY=
# Point this at your own instance to use a different deployment of the service.
# Defaults to https://enigma.mn/api/verify.
EMAIL_VERIFY_BASE_URL=
#
# The recipient is returned to $PUBLIC_ORIGIN/api/v1/verify/landed, which is
# derived from PUBLIC_ORIGIN rather than from the incoming request — a forged
# Host header must not be able to point it somewhere else. The service refuses a
# plain-HTTP return address, so PUBLIC_ORIGIN has to be HTTPS in production.

# No SMTP settings are listed here, and that is deliberate: this platform sends
# no mail of its own. Sign-in codes are issued and delivered by eID and DAN on
# their own channels, and address verification goes through the hosted service
# above. There is no mailbox credential to configure because there is no mailbox.

# Server Document-Signer for the PAdES fallback. Reached only when eID's own
# stamp endpoint is unavailable — it turns a stamp outage into a self-embedded
# signature rather than no signed PDF at all. Signing works without it.
#
# The certificate must be the SAME across restarts and replicas, so it is
# supplied rather than generated: a per-process key would make yesterday's
# fallback signatures unverifiable against today's certificate. Outside
# production a development self-signed pair is generated automatically.
#
# Either inline PEM (\n escapes are accepted) or a mounted file path.
EID_SIGN_SIGNER_CERT_PEM=
EID_SIGN_SIGNER_KEY_PEM=
# EID_SIGN_SIGNER_CERT_FILE=/run/secrets/eid-signer.crt
# EID_SIGN_SIGNER_KEY_FILE=/run/secrets/eid-signer.key
# Base64-encoded 32-byte XChaCha20-Poly1305 key used only for APNs/FCM tokens.
# Generate once with: openssl rand -base64 32
PUSH_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------- Observability
#
# All four are empty by default and empty means off — not "off but still
# allocating", genuinely off: with no endpoint there is no exporter, no batch
# processor and no background goroutine, and every span the code starts is a
# no-op. Full guide in docs/MONITORING.md.

# Where traces go. The monitoring stack runs Tempo and publishes it on the
# platform's Docker network:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://gerege_nexus_tempo:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# What fraction of traces to keep, between 0 and 1. Default 0.1. Everything is
# the obvious wrong answer at any volume: it is a span per query per request.
OTEL_TRACES_SAMPLER_ARG=
# Error tracking, over the Sentry protocol — GlitchTip
# (deploy/docker-compose.glitchtip.yml) or a hosted Sentry, the DSN is the only
# difference. Panics are reported with the request id, the route and the tenant;
# never with a body, a cookie, a query string or a person's address.
SENTRY_DSN=
# Stamped on every reported event, so an error can be tied to a release. CI
# usually sets this to the commit sha.
RELEASE_VERSION=

# Scheduled reports. Empty means schedules still run and are still recorded —
# with "delivery not configured" as the outcome, which the schedule screen
# shows — but nothing is sent.
#
# The design called for scheduled reports to go out through the hosted
# verification service. That service sends one thing, a verification link, and
# has no endpoint for a subject, a body or an attachment; so a scheduled report
# needs a mail transport of its own and SMTP is the one every deployment has an
# answer for. STARTTLS on 587; implicit TLS on 465 is not supported.
REPORT_SMTP_URL=
REPORT_MAIL_FROM=
# Only for a relay on the same host that speaks no TLS. Said explicitly rather
# than inferred from a missing password.
REPORT_SMTP_STARTTLS=true
