<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distribution outside the Mac App Store, signed with the
	     "Developer ID Application: Gerege Systems LLC (CQTHTD6YJQ)" cert and
	     notarized via the gerege-deploy keychain profile. -->
	<key>method</key>
	<string>developer-id</string>
	<key>teamID</key>
	<string>CQTHTD6YJQ</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Hardened Runtime is required for notarization (already set in the
	     build settings; reaffirmed here). -->
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
