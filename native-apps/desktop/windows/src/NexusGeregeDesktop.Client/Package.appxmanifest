<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    Identity: a stable Package Family Name (PFN) derived from Name + Publisher.
    Publisher = the legal entity (Gerege Systems LLC, Apple Team CQTHTD6YJQ).
    On code-sign with a real EV/OV certificate the Publisher MUST match the
    cert subject DN EXACTLY — when ordering the cert, align its subject to the
    value below (adjust here if the CA issues a different DN). The local dev
    cert (tools/dev-cert/New-DevCert.ps1) uses the SAME subject so self-signed
    CI/sideload .msix builds validate against this manifest.
  -->
  <Identity
    Name="mn.gerege.nexus.desktop"
    Publisher="CN=Gerege Systems LLC, O=Gerege Systems LLC, C=MN"
    Version="0.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="0192E6B0-DE49-436F-8CF5-8FEA9D87BFCE" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>NexusGeregeDesktop</DisplayName>
    <PublisherDisplayName>Gerege Systems LLC</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="mn-MN"/>
    <Resource Language="en-US"/>
    <Resource Language="ru-RU"/>
    <Resource Language="zh-CN"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="NexusGeregeDesktop"
        Description="Gerege Nexus — цахим үнэмлэхээр нэвтрэх ширээний клиент."
        BackgroundColor="#001F5E"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#001F5E" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      runFullTrust: required for WinUI 3 desktop apps to access native
      Win32 APIs (DPAPI, PKCS#11, Windows Hello, P/Invoke).
      internetClient: HTTPS to api.eidmongolia.mn.
      No location, microphone, camera, contacts, or files-everywhere.
    -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
