<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexusGeregeDesktop.Client.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NexusGeregeDesktop.Client.Controls"
    xmlns:converters="using:NexusGeregeDesktop.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StatusVariantBrushConverter x:Key="StatusVariantBrushConverter" />
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="24" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <Image Source="ms-appx:///Assets/logo.png" Width="72" Height="72" VerticalAlignment="Top" />
                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource HeroTitleTextBlock}" />
                    <TextBlock Text="{x:Bind ViewModel.Subtitle}" Style="{StaticResource SubtleSubtitleTextBlock}" />
                </StackPanel>
            </StackPanel>

            <controls:AppCard>
                <controls:AppCard.Body>
                    <Grid ColumnSpacing="20" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Row="0" Grid.Column="0"
                                 Width="14" Height="14"
                                 VerticalAlignment="Center"
                                 Fill="{x:Bind ViewModel.StatusVariant, Mode=OneWay, Converter={StaticResource StatusVariantBrushConverter}}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind ViewModel.BackendSectionTitle, Mode=OneWay}"
                                   Style="{StaticResource SectionTitleTextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                        <Button Grid.Row="0" Grid.Column="2"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                ToolTipService.ToolTip="Refresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>

                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}"
                                   Style="{StaticResource PageTitleTextBlock}"
                                   Margin="8,0,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{x:Bind ViewModel.VersionLabel, Mode=OneWay}"
                                   Style="{StaticResource LabelTextBlock}"
                                   Margin="8,0,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{x:Bind ViewModel.LastCheckedLabel, Mode=OneWay}"
                                   Style="{StaticResource LabelTextBlock}"
                                   Margin="8,0,0,0" />
                    </Grid>
                </controls:AppCard.Body>
            </controls:AppCard>
        </StackPanel>
    </ScrollViewer>
</Page>
