<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexusGeregeDesktop.Client.Views.Pages.TokensPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NexusGeregeDesktop.Client.Controls"
    xmlns:vm="using:NexusGeregeDesktop.Presentation.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Center">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" HorizontalAlignment="Stretch">

            <!-- Hero -->
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource HeroTitleTextBlock}" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource SubtleSubtitleTextBlock}" />
            </StackPanel>

            <!-- Tokens list -->
            <controls:AppCard>
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}"
                                       Style="{StaticResource SectionTitleTextBlock}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ScanTokensCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsScanningTokens, Mode=OneWay}" Width="14" Height="14" />
                                    <FontIcon Glyph="&#xE72C;" FontSize="12"
                                              Visibility="{x:Bind ViewModel.IsScanningTokens, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Style="{StaticResource LabelTextBlock}">
                            <Run Text="{x:Bind ViewModel.ProviderLabel, Mode=OneWay}" />
                            <Run Text=": " />
                            <Run Text="{x:Bind ViewModel.ProviderSummary, Mode=OneWay}" FontFamily="Cascadia Code, Consolas, monospace" />
                        </TextBlock>

                        <TextBlock Text="{x:Bind ViewModel.EmptyLabel, Mode=OneWay}"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Visibility="{x:Bind ViewModel.Tokens.Count, Mode=OneWay, Converter={StaticResource IntZeroToVisibilityConverter}}" />

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tokens, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DetectedTokenRow">
                                    <Border BorderBrush="{ThemeResource EidCardStroke}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="12">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE830;" FontSize="16" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                                    <Border Background="{ThemeResource EidAccentSubtleBrush}"
                                                            CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Backend}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource EidAccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource LabelTextBlock}">
                                                    <Run Text="{x:Bind Manufacturer}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{x:Bind Model}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource LabelTextBlock}" FontFamily="Cascadia Code, Consolas, monospace">
                                                    <Run Text="SN: " />
                                                    <Run Text="{x:Bind SerialNumber}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Click="OnViewTokenClick"
                                                    Tag="{x:Bind}"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock x:Uid="Token_View" Text="View" />
                                                    <FontIcon Glyph="&#xE76C;" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>
        </StackPanel>
    </ScrollViewer>
</Page>
