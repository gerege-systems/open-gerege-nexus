<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexusGeregeDesktop.Client.Views.Pages.CertificatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NexusGeregeDesktop.Client.Controls"
    xmlns:vm="using:NexusGeregeDesktop.Presentation.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CountLabelText" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CountValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource EidAccentBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Center">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" HorizontalAlignment="Stretch">

            <!-- Hero -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource HeroTitleTextBlock}" />
                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource SubtleSubtitleTextBlock}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.LoadCommand}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="14" Height="14" />
                        <FontIcon Glyph="&#xE72C;" FontSize="13"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Error banner -->
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="False" />

            <!-- Counts -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:AppCard Grid.Column="0">
                    <controls:AppCard.Body>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.CountsValidLabel, Mode=OneWay}" Style="{StaticResource CountLabelText}" />
                            <TextBlock Text="{x:Bind ViewModel.CountsValid, Mode=OneWay}" Style="{StaticResource CountValueText}" />
                        </StackPanel>
                    </controls:AppCard.Body>
                </controls:AppCard>
                <controls:AppCard Grid.Column="1">
                    <controls:AppCard.Body>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.CountsExpiredLabel, Mode=OneWay}" Style="{StaticResource CountLabelText}" />
                            <TextBlock Text="{x:Bind ViewModel.CountsExpired, Mode=OneWay}" Style="{StaticResource CountValueText}" />
                        </StackPanel>
                    </controls:AppCard.Body>
                </controls:AppCard>
                <controls:AppCard Grid.Column="2">
                    <controls:AppCard.Body>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.CountsRevokedLabel, Mode=OneWay}" Style="{StaticResource CountLabelText}" />
                            <TextBlock Text="{x:Bind ViewModel.CountsRevoked, Mode=OneWay}" Style="{StaticResource CountValueText}" />
                        </StackPanel>
                    </controls:AppCard.Body>
                </controls:AppCard>
                <controls:AppCard Grid.Column="3">
                    <controls:AppCard.Body>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.CountsTotalLabel, Mode=OneWay}" Style="{StaticResource CountLabelText}" />
                            <TextBlock Text="{x:Bind ViewModel.CountsTotal, Mode=OneWay}" Style="{StaticResource CountValueText}" />
                        </StackPanel>
                    </controls:AppCard.Body>
                </controls:AppCard>
            </Grid>

            <!-- List -->
            <controls:AppCard>
                <controls:AppCard.Body>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.EmptyLabel, Mode=OneWay}"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Visibility="{x:Bind ViewModel.Items.Count, Mode=OneWay, Converter={StaticResource IntZeroToVisibilityConverter}}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CertificateRow">
                                    <Border Background="{ThemeResource EidCardBackground}"
                                            BorderBrush="{ThemeResource EidCardStroke}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="14">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xEB95;" FontSize="20" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock>
                                                    <Run Text="{x:Bind TypeLabel}" FontWeight="SemiBold" />
                                                    <Run Text=" · " Foreground="{ThemeResource EidMutedForeground}" />
                                                    <Run Text="{x:Bind Level}" />
                                                </TextBlock>
                                                <TextBlock Text="{x:Bind Issuer}" Style="{StaticResource LabelTextBlock}" />
                                                <TextBlock Text="{x:Bind Validity}" Style="{StaticResource LabelTextBlock}" />
                                                <TextBlock Text="{x:Bind SerialNumber}"
                                                           FontFamily="Consolas"
                                                           Style="{StaticResource LabelTextBlock}" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Background="{Binding StatusVariant, Converter={StaticResource StatusVariantBrushConverter}}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StatusLabel}"
                                                           Foreground="White"
                                                           FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                            <Button Grid.Column="3" VerticalAlignment="Center"
                                                    IsEnabled="{x:Bind HasDer}"
                                                    Tag="{x:Bind}" Click="OnViewClick">
                                                <FontIcon Glyph="&#xE890;" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>
        </StackPanel>
    </ScrollViewer>
</Page>
