<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexusGeregeDesktop.Client.Views.Pages.SignPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NexusGeregeDesktop.Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CodeDigitBox" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="64" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{ThemeResource EidAccentBrush}" />
            <Setter Property="Background" Value="{ThemeResource EidAccentSubtleBrush}" />
        </Style>
        <Style x:Key="CodeDigitText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource EidAccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" HorizontalAlignment="Stretch" MaxWidth="640">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource HeroTitleTextBlock}" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle}" Style="{StaticResource SubtleSubtitleTextBlock}" />
            </StackPanel>

            <!-- Idle: pick a PDF -->
            <controls:AppCard Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Spacing="14" HorizontalAlignment="Center" Padding="0,10">
                        <FontIcon Glyph="&#xE8E5;" FontSize="30" Foreground="{ThemeResource EidAccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.PickTitle, Mode=OneWay}"
                                   Style="{StaticResource SectionTitleTextBlock}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.PickHint, Mode=OneWay}"
                                   Style="{StaticResource LabelTextBlock}"
                                   TextAlignment="Center" />
                        <Button Click="OnPickFileClick"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.CanSign, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="{x:Bind ViewModel.PickButton, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.NotSignedInLabel, Mode=OneWay}"
                                   Style="{StaticResource LabelTextBlock}"
                                   Foreground="{ThemeResource EidDangerBrush}"
                                   TextAlignment="Center"
                                   Visibility="{x:Bind ViewModel.CanSign, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- Uploading -->
            <controls:AppCard Visibility="{x:Bind ViewModel.IsUploading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <ProgressRing IsActive="True" Width="28" Height="28" VerticalAlignment="Center" />
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.UploadingLabel, Mode=OneWay}"
                                       Style="{StaticResource SectionTitleTextBlock}" />
                            <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
                                       Style="{StaticResource LabelTextBlock}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- Waiting: verification code + poll -->
            <controls:AppCard Visibility="{x:Bind ViewModel.IsWaiting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.VerificationLabel, Mode=OneWay}"
                                   Style="{StaticResource LabelTextBlock}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CodeDigitBox}">
                                <TextBlock Text="{x:Bind ViewModel.Digit1, Mode=OneWay}" Style="{StaticResource CodeDigitText}" />
                            </Border>
                            <Border Style="{StaticResource CodeDigitBox}">
                                <TextBlock Text="{x:Bind ViewModel.Digit2, Mode=OneWay}" Style="{StaticResource CodeDigitText}" />
                            </Border>
                            <Border Style="{StaticResource CodeDigitBox}">
                                <TextBlock Text="{x:Bind ViewModel.Digit3, Mode=OneWay}" Style="{StaticResource CodeDigitText}" />
                            </Border>
                            <Border Style="{StaticResource CodeDigitBox}">
                                <TextBlock Text="{x:Bind ViewModel.Digit4, Mode=OneWay}" Style="{StaticResource CodeDigitText}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.WaitingInstruction, Mode=OneWay}"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   TextAlignment="Center"
                                   MaxWidth="380" />

                        <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                            <TextBlock>
                                <Run Text="{x:Bind ViewModel.FileLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=": " />
                                <Run Text="{x:Bind ViewModel.FileName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" TextWrapping="Wrap">
                                <Run Text="SHA-256" FontWeight="SemiBold" />
                                <Run Text=": " />
                                <Run Text="{x:Bind ViewModel.HashHex, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <ProgressRing IsActive="True" Width="16" Height="16" />
                            <TextBlock Text="{x:Bind ViewModel.WaitingStatus, Mode=OneWay}"
                                       Style="{StaticResource LabelTextBlock}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Command="{x:Bind ViewModel.CancelCommand}" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CancelLabel, Mode=OneWay}" />
                        </Button>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- Completed -->
            <controls:AppCard Visibility="{x:Bind ViewModel.IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE930;" FontSize="20" Foreground="{ThemeResource EidSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.CompletedTitle, Mode=OneWay}"
                                       Style="{StaticResource SectionTitleTextBlock}"
                                       Foreground="{ThemeResource EidSuccessBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SuggestedFileName, Mode=OneWay}"
                                   FontFamily="Cascadia Code, Consolas, monospace" />
                        <TextBlock Text="{x:Bind ViewModel.CompletedHint, Mode=OneWay}"
                                   Style="{StaticResource LabelTextBlock}" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="OnSaveClick" Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.SaveButton, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ResetCommand}">
                                <TextBlock Text="{x:Bind ViewModel.NewFileLabel, Mode=OneWay}" />
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    Visibility="{x:Bind ViewModel.IsSaved, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource EidSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SavedNotice, Mode=OneWay}"
                                       Style="{StaticResource LabelTextBlock}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- Error -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <InfoBar IsOpen="{x:Bind ViewModel.IsError, Mode=OneWay}"
                         IsClosable="False"
                         Severity="Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                <Button Command="{x:Bind ViewModel.ResetCommand}" HorizontalAlignment="Left">
                    <TextBlock Text="{x:Bind ViewModel.TryAgainLabel, Mode=OneWay}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
