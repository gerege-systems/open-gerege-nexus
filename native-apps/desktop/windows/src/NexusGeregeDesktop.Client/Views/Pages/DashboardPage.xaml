<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexusGeregeDesktop.Client.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NexusGeregeDesktop.Client.Controls"
    xmlns:vm="using:NexusGeregeDesktop.Presentation.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="StatLabelText" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StatValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource EidAccentBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" HorizontalAlignment="Stretch">

            <!-- Hero -->
            <controls:AppCard>
                <controls:AppCard.Body>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0"
                               Source="ms-appx:///Assets/logo.png"
                               Width="56" Height="56"
                               VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <StackPanel>
                                    <TextBlock x:Uid="App_Wordmark_Top" Text="National ID"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="{ThemeResource EidAccentBrush}"
                                               CharacterSpacing="80" />
                                    <TextBlock x:Uid="App_Tagline" Text="Digital Sovereignty"
                                               FontSize="10"
                                               Foreground="{ThemeResource EidMutedForeground}" />
                                </StackPanel>
                                <Border Background="{ThemeResource EidAccentSubtleBrush}"
                                        BorderBrush="{ThemeResource EidAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="10,4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource EidSuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.StatusBadge, Mode=OneWay}"
                                                   Foreground="{ThemeResource EidAccentBrush}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock>
                                <Run Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Foreground="{ThemeResource EidMutedForeground}" />
                                <Run Text=" " />
                                <Run Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                       Style="{StaticResource SubtleSubtitleTextBlock}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.LoadCommand}"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="14" Height="14" />
                                <FontIcon Glyph="&#xE72C;" FontSize="13"
                                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- Stats grid -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:AppCard Grid.Column="0">
                    <controls:AppCard.Body>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.StatsSecurityScoreLabel, Mode=OneWay}" Style="{StaticResource StatLabelText}" />
                            <TextBlock Text="{x:Bind ViewModel.DisplaySecurityScore, Mode=OneWay}" Style="{StaticResource StatValueText}" />
                        </StackPanel>
                    </controls:AppCard.Body>
                </controls:AppCard>
                <controls:AppCard Grid.Column="1">
                    <controls:AppCard.Body>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.StatsCertificatesLabel, Mode=OneWay}" Style="{StaticResource StatLabelText}" />
                            <TextBlock Text="{x:Bind ViewModel.DisplayCertCount, Mode=OneWay}" Style="{StaticResource StatValueText}" />
                        </StackPanel>
                    </controls:AppCard.Body>
                </controls:AppCard>
                <controls:AppCard Grid.Column="2">
                    <controls:AppCard.Body>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.StatsLoginsLabel, Mode=OneWay}" Style="{StaticResource StatLabelText}" />
                            <TextBlock Text="{x:Bind ViewModel.DisplayLoginCount, Mode=OneWay}" Style="{StaticResource StatValueText}" />
                        </StackPanel>
                    </controls:AppCard.Body>
                </controls:AppCard>
                <controls:AppCard Grid.Column="3">
                    <controls:AppCard.Body>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.StatsLastLoginLabel, Mode=OneWay}" Style="{StaticResource StatLabelText}" />
                            <TextBlock Text="{x:Bind ViewModel.DisplayLastLogin, Mode=OneWay}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource EidAccentBrush}" />
                        </StackPanel>
                    </controls:AppCard.Body>
                </controls:AppCard>
            </Grid>

            <!-- Devices -->
            <controls:AppCard>
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.DevicesSectionTitle, Mode=OneWay}"
                                   Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBlock Text="{x:Bind ViewModel.DevicesEmpty, Mode=OneWay}"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Visibility="{x:Bind ViewModel.Devices.Count, Mode=OneWay, Converter={StaticResource IntZeroToVisibilityConverter}}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceRow">
                                    <Border Background="{ThemeResource EidCardBackground}"
                                            BorderBrush="{ThemeResource EidCardStroke}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE8EA;" FontSize="20" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind PlatformLabel}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource LabelTextBlock}">
                                                    <Run Text="{x:Bind CreatedAt}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{x:Bind LastUsedAt}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Background="{Binding StatusVariant, Converter={StaticResource StatusVariantBrushConverter}}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StatusLabel}"
                                                           Foreground="White"
                                                           FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- Activity -->
            <controls:AppCard>
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.ActivitySectionTitle, Mode=OneWay}"
                                   Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBlock Text="{x:Bind ViewModel.ActivityEmpty, Mode=OneWay}"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Visibility="{x:Bind ViewModel.Activity.Count, Mode=OneWay, Converter={StaticResource IntZeroToVisibilityConverter}}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActivityRow">
                                    <Border BorderBrush="{ThemeResource EidCardStroke}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock>
                                                    <Run Text="{x:Bind Kind}" FontWeight="SemiBold" />
                                                    <Run Text=" · " Foreground="{ThemeResource EidMutedForeground}" />
                                                    <Run Text="{x:Bind Service}" />
                                                </TextBlock>
                                                <TextBlock Text="{x:Bind RpName}"
                                                           Style="{StaticResource LabelTextBlock}"
                                                           Visibility="{x:Bind RpName, Converter={StaticResource StringNonEmptyToVisibilityConverter}}" />
                                                <TextBlock Text="{x:Bind PushText}"
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource LabelTextBlock}"
                                                           Visibility="{x:Bind PushText, Converter={StaticResource StringNonEmptyToVisibilityConverter}}" />
                                                <TextBlock Text="{x:Bind Meta}"
                                                           FontFamily="Consolas"
                                                           Style="{StaticResource LabelTextBlock}"
                                                           Visibility="{x:Bind Meta, Converter={StaticResource StringNonEmptyToVisibilityConverter}}" />
                                                <TextBlock Text="{x:Bind CreatedAt}"
                                                           Style="{StaticResource LabelTextBlock}" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{Binding ResultVariant, Converter={StaticResource StatusVariantBrushConverter}}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ResultLabel}"
                                                           Foreground="White"
                                                           FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- Error inline -->
            <InfoBar IsOpen="{x:Bind ViewModel.IsError, Mode=OneWay}"
                     Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
