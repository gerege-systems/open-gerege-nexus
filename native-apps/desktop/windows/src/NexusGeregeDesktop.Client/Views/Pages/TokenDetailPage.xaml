<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexusGeregeDesktop.Client.Views.Pages.TokenDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NexusGeregeDesktop.Client.Controls"
    xmlns:vm="using:NexusGeregeDesktop.Presentation.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" HorizontalAlignment="Stretch">

            <!-- Back -->
            <Button Command="{x:Bind ViewModel.BackCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="{x:Bind ViewModel.BackLabel, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <!-- Hero -->
            <controls:AppCard>
                <controls:AppCard.Body>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE830;" FontSize="20" Foreground="{ThemeResource EidAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.TokenLabel, Mode=OneWay}"
                                       Style="{StaticResource HeroTitleTextBlock}" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource EidAccentSubtleBrush}"
                                    CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Backend, Mode=OneWay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource EidAccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource LabelTextBlock}">
                            <Run Text="{x:Bind ViewModel.ProviderDisplay, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource LabelTextBlock}">
                            <Run Text="{x:Bind ViewModel.TokenManufacturer, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{x:Bind ViewModel.TokenModel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource LabelTextBlock}" FontFamily="Cascadia Code, Consolas, monospace">
                            <Run Text="SN: " />
                            <Run Text="{x:Bind ViewModel.TokenSerial, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource LabelTextBlock}"
                                   Foreground="{ThemeResource EidMutedForeground}" />

                        <!-- M9.D state badge + capabilities. Visible only when
                             discovery actually populated a non-Unknown state. -->
                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.StateLabel, Mode=OneWay, Converter={StaticResource StringNonEmptyToVisibilityConverter}}">
                            <Border Background="{ThemeResource EidAccentSubtleBrush}"
                                    CornerRadius="10" Padding="10,4"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.StateLabel, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource EidAccentBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.CapabilitiesSummary, Mode=OneWay}"
                                       Style="{StaticResource LabelTextBlock}"
                                       FontFamily="Cascadia Code, Consolas, monospace"
                                       FontSize="11" />
                            <!-- T4: memory usage row, PKCS#11-only signal —
                                 the StringNonEmptyToVisibilityConverter
                                 hides this row entirely on CNG tokens where
                                 the backend can't read memory info. -->
                            <TextBlock Text="{x:Bind ViewModel.MemorySummary, Mode=OneWay}"
                                       Style="{StaticResource LabelTextBlock}"
                                       FontFamily="Cascadia Code, Consolas, monospace"
                                       FontSize="11"
                                       Visibility="{x:Bind ViewModel.MemorySummary, Mode=OneWay, Converter={StaticResource StringNonEmptyToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- Sticky enrollment success banner. Pops after the
                 EnrollTokenCommand completes; closable so the citizen
                 can dismiss it once they've read it. Severity=Success
                 paints it green for unambiguous "this worked". -->
            <InfoBar IsOpen="{x:Bind ViewModel.EnrollSuccessVisible, Mode=TwoWay}"
                     Severity="Success"
                     Title="✅ Токен амжилттай бүртгэгдлээ"
                     Message="Нэвтрэх хуудасны 'USB Token' хэсгээс энэ токеноор шууд нэвтэрч болно." />

            <!-- T7 / T10 entry point: "Rename / re-initialize token"
                 card. Visible for any non-Blank state (Blank shows the
                 init wizard outright). Clicking the button flips
                 FormatRequested so the init wizard below appears. -->
            <controls:AppCard Visibility="{x:Bind ViewModel.NeedsFirstTimeSetup, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Spacing="10"
                                Visibility="{x:Bind ViewModel.FormatRequested, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock x:Uid="Token_Rename_Title" Text="Rename / re-initialize token" Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Text="⚠ Per the PKCS#11 standard, changing the token label requires re-initializing the token — all on-card keys and certificates will be erased. Use the vendor's PKI tool for a non-destructive rename if your card driver supports it." />
                        <Button Command="{x:Bind ViewModel.RequestFormatCommand}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#B91C1C" />
                                <TextBlock Text="Re-initialize with new label..." />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- M9.D.3: First-time-setup PIN init wizard. Visible when
                 the token is Blank OR the citizen explicitly requested
                 a destructive re-init via the card above. -->
            <controls:AppCard Visibility="{x:Bind ViewModel.ShowInitWizard, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <TextBlock Text="First-time token setup"
                                   Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Text="⚠️ DESTRUCTIVE: this wipes all existing keys and certs on the token. Only run this on a brand new card (or one you intentionally want to reset). Requires the PKCS#11 backend." />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Admin (SO) PIN"
                                       Style="{StaticResource LabelTextBlock}" />
                            <PasswordBox Password="{x:Bind ViewModel.InitSoPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{x:Bind ViewModel.SoPinPlaceholder}"
                                         FontFamily="Cascadia Code, Consolas, monospace" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Token label"
                                       Style="{StaticResource LabelTextBlock}" />
                            <TextBox Text="{x:Bind ViewModel.InitLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="32"
                                     FontFamily="Cascadia Code, Consolas, monospace" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="New user PIN" Style="{StaticResource LabelTextBlock}" />
                                <PasswordBox Password="{x:Bind ViewModel.InitUserPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Confirm PIN" Style="{StaticResource LabelTextBlock}" />
                                <PasswordBox Password="{x:Bind ViewModel.InitUserPinConfirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>
                        </Grid>
                        <Button Command="{x:Bind ViewModel.InitTokenCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsInitializingToken, Mode=OneWay}" Width="14" Height="14" />
                                <FontIcon Glyph="&#xE7BA;" FontSize="13"
                                          Visibility="{x:Bind ViewModel.IsInitializingToken, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="Initialize token" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- PIN unlock (PKCS#11 only) -->
            <controls:AppCard Visibility="{x:Bind ViewModel.NeedsPinEntry, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.PinSectionLabel, Mode=OneWay}" Style="{StaticResource SectionTitleTextBlock}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0"
                                         Password="{x:Bind ViewModel.PinInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{x:Bind ViewModel.PinPlaceholder, Mode=OneWay}"
                                         FontFamily="Cascadia Code, Consolas, monospace"
                                         KeyDown="OnPinKeyDown" />
                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.UnlockCommand}"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsUnlocking, Mode=OneWay}" Width="14" Height="14" />
                                    <TextBlock Text="{x:Bind ViewModel.UnlockLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- Objects -->
            <controls:AppCard>
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.ObjectsSectionLabel, Mode=OneWay}"
                                       Style="{StaticResource SectionTitleTextBlock}"
                                       VerticalAlignment="Center" />
                            <!-- T5: pick a .cer/.pem file and install onto
                                 this token's existing on-card key. -->
                            <Button Grid.Column="1"
                                    Click="OnImportCertClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsImportingCert, Mode=OneWay}" Width="14" Height="14" />
                                    <FontIcon Glyph="&#xE8E5;" FontSize="12"
                                              Visibility="{x:Bind ViewModel.IsImportingCert, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <TextBlock x:Uid="Token_Import_Button" Text="Import certificate…" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.ImportCertStatus, Mode=OneWay}"
                                   Style="{StaticResource LabelTextBlock}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.ImportCertStatus, Mode=OneWay, Converter={StaticResource StringNonEmptyToVisibilityConverter}}" />
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind ViewModel.IsLoadingObjects, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="True" Width="14" Height="14" />
                            <TextBlock Text="{x:Bind ViewModel.ObjectsLoadingLabel, Mode=OneWay}" Style="{StaticResource LabelTextBlock}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ObjectsEmptyLabel, Mode=OneWay}"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Visibility="{x:Bind ViewModel.Objects.Count, Mode=OneWay, Converter={StaticResource IntZeroToVisibilityConverter}}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Objects, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:TokenObjectRow">
                                    <Border BorderBrush="{ThemeResource EidCardStroke}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <!-- Гэрчилгээ бол эзэмшигчийн нэр + РД (2 ижил токеныг ялгах) -->
                                                <TextBlock Text="{x:Bind OwnerName}" FontWeight="SemiBold" FontSize="14"
                                                           Visibility="{x:Bind HasOwnerInfo, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="{x:Bind OwnerLine}" Style="{StaticResource LabelTextBlock}"
                                                           Visibility="{x:Bind HasOwnerInfo, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="{x:Bind DetailLine}" Style="{StaticResource LabelTextBlock}"
                                                           Visibility="{x:Bind HasOwnerInfo, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold"
                                                           Visibility="{x:Bind HasOwnerInfo, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                <TextBlock Style="{StaticResource LabelTextBlock}" FontFamily="Cascadia Code, Consolas, monospace">
                                                    <Run Text="{x:Bind Kind}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{x:Bind KeyAlgorithm}" />
                                                    <Run Text=" · ID: " />
                                                    <Run Text="{x:Bind Id}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- "View" button only for Certificate rows; private/public
                                                 keys have no useful detail beyond what the row already
                                                 shows. The "Delete" button is universal — both certs
                                                 and on-card keys can be destroyed (T6). -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Click="OnCertDetailClick"
                                                        Tag="{x:Bind}"
                                                        Visibility="{x:Bind IsCertificate, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE946;" FontSize="11" />
                                                        <TextBlock Text="View" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="OnDeleteObjectClick"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Delete">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#B91C1C" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- M9.E: Change PIN. Visible for tokens with a user PIN set
                 (Blank tokens use the D.3 init wizard above). -->
            <controls:AppCard Visibility="{x:Bind ViewModel.CanShowPinChange, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Change user PIN" Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Text="Update the PIN that unlocks this token's keys for signing. For CNG-discovered tokens, Windows defers to the vendor's PKI tool — the UI will surface that hint." />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Current PIN" Style="{StaticResource LabelTextBlock}" />
                            <PasswordBox Password="{x:Bind ViewModel.CurrentPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Code, Consolas, monospace" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="New PIN" Style="{StaticResource LabelTextBlock}" />
                                <PasswordBox Password="{x:Bind ViewModel.NewPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Confirm new PIN" Style="{StaticResource LabelTextBlock}" />
                                <PasswordBox Password="{x:Bind ViewModel.NewPinConfirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ChangePinCommand}"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsChangingPin, Mode=OneWay}" Width="14" Height="14" />
                                    <FontIcon Glyph="&#xE710;" FontSize="13"
                                              Visibility="{x:Bind ViewModel.IsChangingPin, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <TextBlock Text="Change PIN" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.LaunchVendorPinToolCommand}"
                                    Visibility="{x:Bind ViewModel.ShowVendorToolButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    <TextBlock Text="Open vendor tool" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.PinChangeStatus, Mode=OneWay}"
                                   Style="{StaticResource LabelTextBlock}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.PinChangeStatus, Mode=OneWay, Converter={StaticResource StringNonEmptyToVisibilityConverter}}" />
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- T8: Unlock user PIN with SO PIN. Visible alongside the
                 Change PIN card; citizens hit this when too many wrong
                 PIN entries have tripped CKF_USER_PIN_LOCKED. -->
            <controls:AppCard Visibility="{x:Bind ViewModel.CanShowPinUnlock, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Unlock user PIN (SO PIN required)" Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Text="When the user PIN is locked (too many wrong tries), the admin / SO PIN can reset it without erasing the on-card keys or certificates. CNG-discovered tokens defer this to the vendor PKI tool." />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Admin (SO) PIN" Style="{StaticResource LabelTextBlock}" />
                            <PasswordBox Password="{x:Bind ViewModel.UnlockSoPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{x:Bind ViewModel.SoPinPlaceholder}"
                                         FontFamily="Cascadia Code, Consolas, monospace" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="New user PIN" Style="{StaticResource LabelTextBlock}" />
                                <PasswordBox Password="{x:Bind ViewModel.UnlockNewPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Confirm new user PIN" Style="{StaticResource LabelTextBlock}" />
                                <PasswordBox Password="{x:Bind ViewModel.UnlockNewPinConfirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>
                        </Grid>
                        <Button Command="{x:Bind ViewModel.UnlockPinCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsUnlockingPin, Mode=OneWay}" Width="14" Height="14" />
                                <FontIcon Glyph="&#xE785;" FontSize="13"
                                          Visibility="{x:Bind ViewModel.IsUnlockingPin, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="Unlock PIN" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.UnlockPinStatus, Mode=OneWay}"
                                   Style="{StaticResource LabelTextBlock}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.UnlockPinStatus, Mode=OneWay, Converter={StaticResource StringNonEmptyToVisibilityConverter}}" />
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- T9: Change SO PIN. Rotates the admin PIN without
                 touching the user PIN or on-card data. CNG defers to
                 the vendor PKI tool. -->
            <controls:AppCard Visibility="{x:Bind ViewModel.CanShowSoPinChange, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Change SO (admin) PIN" Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Text="Rotate the admin PIN that's required for token initialization and user-PIN unlock. The user PIN and on-card data stay unchanged. CNG-discovered tokens defer to the vendor PKI tool." />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Current SO PIN" Style="{StaticResource LabelTextBlock}" />
                            <PasswordBox Password="{x:Bind ViewModel.OldSoPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Code, Consolas, monospace" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="New SO PIN" Style="{StaticResource LabelTextBlock}" />
                                <PasswordBox Password="{x:Bind ViewModel.NewSoPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Confirm new SO PIN" Style="{StaticResource LabelTextBlock}" />
                                <PasswordBox Password="{x:Bind ViewModel.NewSoPinConfirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>
                        </Grid>
                        <Button Command="{x:Bind ViewModel.ChangeSoPinCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsChangingSoPin, Mode=OneWay}" Width="14" Height="14" />
                                <FontIcon Glyph="&#xE192;" FontSize="13"
                                          Visibility="{x:Bind ViewModel.IsChangingSoPin, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="Change SO PIN" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.ChangeSoPinStatus, Mode=OneWay}"
                                   Style="{StaticResource LabelTextBlock}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.ChangeSoPinStatus, Mode=OneWay, Converter={StaticResource StringNonEmptyToVisibilityConverter}}" />
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- T11: Fingerprint manager. Visible only when discovery
                 flagged the token as having an on-board biometric sensor.
                 Two routing buttons because two distinct hardware paths:
                   - Feitian BioPass2003: managed via the vendor's PKI
                     Manager → "Fingerprint Manager" tab.
                   - Token2 K49/K50 Pro: registered with Windows
                     Biometric Framework → Settings → Sign-in options. -->
            <controls:AppCard Visibility="{x:Bind ViewModel.ShowFingerprintCard, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE928;" FontSize="18" Foreground="{ThemeResource EidAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Fingerprint manager" Style="{StaticResource SectionTitleTextBlock}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Text="Энэ токен дотроо хурууны хээ уншигчтай байна. Тохиргооны хоёр зам байгаа: Feitian BioPass төрөл бол vendor-н PKI Manager → 'Fingerprint Manager' хэсэгт хурууны хээгээ бүртгүүлнэ. Token2 K49/K50 Pro төрөл бол Windows Hello-той интеграцчилагдсан тул Windows Settings → Sign-in options → Fingerprint recognition хэсэгт бүртгүүлнэ." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.LaunchVendorPinToolCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    <TextBlock Text="Open vendor PKI Manager" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenWindowsHelloSettingsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                                    <TextBlock Text="Open Windows Hello settings" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- Sign test -->
            <controls:AppCard>
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.SignTestSectionLabel, Mode=OneWay}" Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBlock Text="{x:Bind ViewModel.CngHintLabel, Mode=OneWay}"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Visibility="{x:Bind ViewModel.IsCng, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Key" Style="{StaticResource LabelTextBlock}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.PrivateKeys, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedSignKey, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      MinWidth="320" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.SignTestDataLabel, Mode=OneWay}" Style="{StaticResource LabelTextBlock}" />
                            <TextBox Text="{x:Bind ViewModel.SignData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Cascadia Code, Consolas, monospace" />
                        </StackPanel>
                        <Button Command="{x:Bind ViewModel.SignTestCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsSigning, Mode=OneWay}" Width="14" Height="14" />
                                <FontIcon Glyph="&#xE192;" FontSize="13"
                                          Visibility="{x:Bind ViewModel.IsSigning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.SignTestRunLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.SignResultHex, Mode=OneWay, Converter={StaticResource StringNonEmptyToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource LabelTextBlock}">
                                <Run Text="{x:Bind ViewModel.SignTestResultLabel, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{x:Bind ViewModel.SignResultAlg, Mode=OneWay}" />
                            </TextBlock>
                            <TextBox Text="{x:Bind ViewModel.SignResultHex, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Cascadia Code, Consolas, monospace"
                                     FontSize="11"
                                     Height="80" />
                        </StackPanel>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- M9.D.4 — Generate signing key on token. Visible only when
                 State == Initialized (PIN set, no key yet). -->
            <controls:AppCard Visibility="{x:Bind ViewModel.NeedsKeyGeneration, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Generate signing key on token"
                                   Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   Text="The token PIN is set, but no signing key exists yet. Generating an RSA-2048 keypair stores it on the token (non-exportable). Windows or the token will prompt for your PIN during this step." />
                        <Button Command="{x:Bind ViewModel.GenerateKeyPairCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsGeneratingKeyPair, Mode=OneWay}" Width="14" Height="14" />
                                <FontIcon Glyph="&#xE7C5;" FontSize="13"
                                          Visibility="{x:Bind ViewModel.IsGeneratingKeyPair, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="Generate RSA-2048 keypair" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- M9.D.6 — "Ready to use" indicator. Visible only when
                 State == Enrolled. Shows the citizen the next step. -->
            <controls:AppCard Visibility="{x:Bind ViewModel.IsFullyEnrolled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE930;" FontSize="20" Foreground="#16A34A" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Token is enrolled and ready" FontWeight="SemiBold" />
                            <TextBlock Text="You can sign in using the USB Token tab on the Login screen."
                                       Style="{StaticResource SubtleSubtitleTextBlock}" />
                        </StackPanel>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- M9.C — Setup-for-login (CSR + enrollment + install).
                 Visible only when State == Provisioned (key present,
                 cert is self-signed or absent). -->
            <controls:AppCard Visibility="{x:Bind ViewModel.NeedsEnrollment, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppCard.Body>
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.EnrollSectionLabel, Mode=OneWay}" Style="{StaticResource SectionTitleTextBlock}" />
                        <TextBlock Text="{x:Bind ViewModel.EnrollHintLabel, Mode=OneWay}"
                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                   TextWrapping="Wrap" />
                        <Button Command="{x:Bind ViewModel.EnrollTokenCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsEnrolling, Mode=OneWay}" Width="14" Height="14" />
                                <FontIcon Glyph="&#xE713;" FontSize="13"
                                          Visibility="{x:Bind ViewModel.IsEnrolling, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.EnrollRunLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <TextBox Text="{x:Bind ViewModel.EnrollStatusMessage, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Cascadia Code, Consolas, monospace"
                                 FontSize="11"
                                 MinHeight="80"
                                 MaxHeight="240"
                                 Visibility="{x:Bind ViewModel.EnrollStatusMessage, Mode=OneWay, Converter={StaticResource StringNonEmptyToVisibilityConverter}}" />
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>

            <!-- Error -->
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
