<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexusGeregeDesktop.Client.Views.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NexusGeregeDesktop.Client.Controls"
    xmlns:converters="using:NexusGeregeDesktop.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CodeDigitBox" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="64" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{ThemeResource EidAccentBrush}" />
            <Setter Property="Background" Value="{ThemeResource EidAccentSubtleBrush}" />
        </Style>
        <Style x:Key="CodeDigitText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource EidAccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="TabButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="BorderBrush" Value="{ThemeResource EidAccentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource EidAccentBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid HorizontalAlignment="Stretch">
            <controls:AppCard MaxWidth="480"
                              Margin="32"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Center">
                <controls:AppCard.Body>
                    <StackPanel Spacing="20">

                        <!-- Hero -->
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <Border CornerRadius="14" Width="64" Height="64" HorizontalAlignment="Center">
                                <Image Source="ms-appx:///Assets/logo.png" Width="64" Height="64" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                       Style="{StaticResource HeroTitleTextBlock}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                       Style="{StaticResource SubtleSubtitleTextBlock}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <!-- Tab switcher (only when not in Waiting/Success) -->
                        <Grid Visibility="{x:Bind ViewModel.IsWaiting, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Grid Visibility="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderThickness="0,0,0,2"
                                        BorderBrush="{x:Bind ViewModel.IsNationalIdMode, Mode=OneWay, Converter={StaticResource TabUnderlineBrushConverter}}">
                                    <Button Command="{x:Bind ViewModel.SelectModeCommand}"
                                            CommandParameter="id"
                                            Style="{StaticResource TabButtonStyle}"
                                            Background="Transparent">
                                        <TextBlock x:Uid="Login_Tab_NationalId" Text="National ID"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind ViewModel.IsNationalIdMode, Mode=OneWay, Converter={StaticResource TabForegroundBrushConverter}}" />
                                    </Button>
                                </Border>
                                <Border Grid.Column="1" BorderThickness="0,0,0,2"
                                        BorderBrush="{x:Bind ViewModel.IsQrMode, Mode=OneWay, Converter={StaticResource TabUnderlineBrushConverter}}">
                                    <Button Command="{x:Bind ViewModel.SelectModeCommand}"
                                            CommandParameter="qr"
                                            Style="{StaticResource TabButtonStyle}"
                                            Background="Transparent">
                                        <TextBlock x:Uid="Login_Tab_Qr" Text="QR code"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind ViewModel.IsQrMode, Mode=OneWay, Converter={StaticResource TabForegroundBrushConverter}}" />
                                    </Button>
                                </Border>
                                <Border Grid.Column="2" BorderThickness="0,0,0,2"
                                        BorderBrush="{x:Bind ViewModel.IsTokenMode, Mode=OneWay, Converter={StaticResource TabUnderlineBrushConverter}}">
                                    <Button Command="{x:Bind ViewModel.SelectModeCommand}"
                                            CommandParameter="token"
                                            Style="{StaticResource TabButtonStyle}"
                                            Background="Transparent">
                                        <TextBlock x:Uid="Login_Tab_Token" Text="USB Token"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind ViewModel.IsTokenMode, Mode=OneWay, Converter={StaticResource TabForegroundBrushConverter}}" />
                                    </Button>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ID input (only in NationalId mode, idle/loading/error) -->
                        <StackPanel Spacing="12"
                                    Visibility="{x:Bind ViewModel.IsNationalIdMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="12"
                                        Visibility="{x:Bind ViewModel.IsWaiting, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind ViewModel.NationalIdLabel, Mode=OneWay}"
                                               Style="{StaticResource LabelTextBlock}" />
                                    <TextBox x:Name="NationalIdBox"
                                             Text="{x:Bind ViewModel.NationalId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{x:Bind ViewModel.NationalIdPlaceholder, Mode=OneWay}"
                                             CharacterCasing="Upper"
                                             MaxLength="10"
                                             FontFamily="Cascadia Code, Consolas, monospace"
                                             FontSize="16"
                                             IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                             KeyDown="OnNationalIdKeyDown" />
                                    <TextBlock Text="{x:Bind ViewModel.NationalIdHint, Mode=OneWay}"
                                               Style="{StaticResource LabelTextBlock}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- QR mode idle/loading: hint + ProgressRing (auto-initiates) -->
                        <StackPanel Spacing="16" HorizontalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsQrMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="16" HorizontalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.IsWaiting, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel Spacing="16" HorizontalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel Spacing="16" HorizontalAlignment="Center"
                                                Visibility="{x:Bind ViewModel.IsError, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <ProgressRing IsActive="True" Width="48" Height="48" />
                                        <TextBlock x:Uid="Login_Qr_Hint" Text="Scan this QR code with the e-ID Mongolia app."
                                                   Style="{StaticResource SubtleSubtitleTextBlock}"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Token mode (M9.B): list available USB tokens, optional PIN, sign-in -->
                        <StackPanel Spacing="14"
                                    Visibility="{x:Bind ViewModel.IsTokenMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="14"
                                        Visibility="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind ViewModel.TokenSectionLabel, Mode=OneWay}"
                                               Style="{StaticResource SectionTitleTextBlock}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{x:Bind ViewModel.ScanTokensCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ProgressRing IsActive="{x:Bind ViewModel.IsScanningTokens, Mode=OneWay}" Width="14" Height="14" />
                                            <FontIcon Glyph="&#xE72C;" FontSize="12"
                                                      Visibility="{x:Bind ViewModel.IsScanningTokens, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <TextBlock Text="{x:Bind ViewModel.TokenScanLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableTokens, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedToken, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          MinWidth="320">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xF2B7;" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                    <Border Background="{ThemeResource EidAccentSubtleBrush}"
                                                            CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Backend}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource EidAccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource LabelTextBlock}" FontFamily="Cascadia Code, Consolas, monospace">
                                                    <Run Text="SN: " />
                                                    <Run Text="{Binding SerialNumber}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="{x:Bind ViewModel.TokenEmptyLabel, Mode=OneWay}"
                                           Style="{StaticResource SubtleSubtitleTextBlock}"
                                           Visibility="{x:Bind ViewModel.AvailableTokens.Count, Mode=OneWay, Converter={StaticResource IntZeroToVisibilityConverter}}" />

                                <!-- PIN (PKCS#11 tokens only) -->
                                <StackPanel Spacing="6"
                                            Visibility="{x:Bind ViewModel.RequiresPin, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind ViewModel.TokenPinLabel, Mode=OneWay}"
                                               Style="{StaticResource LabelTextBlock}" />
                                    <PasswordBox Password="{x:Bind ViewModel.TokenPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{x:Bind ViewModel.TokenPinPlaceholder, Mode=OneWay}"
                                                 FontFamily="Cascadia Code, Consolas, monospace" />
                                </StackPanel>

                                <TextBlock Text="{x:Bind ViewModel.TokenStatusMessage, Mode=OneWay}"
                                           Style="{StaticResource LabelTextBlock}"
                                           Visibility="{x:Bind ViewModel.TokenStatusMessage, Mode=OneWay, Converter={StaticResource StringNonEmptyToVisibilityConverter}}" />

                                <Button Command="{x:Bind ViewModel.SignInWithTokenCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Height="42">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="16" Height="16" />
                                        <FontIcon Glyph="&#xE8EA;" FontSize="14"
                                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        <TextBlock Text="{x:Bind ViewModel.TokenSignInLabel, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </StackPanel>

                        <!-- Common: error inline + initiate button -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsWaiting, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Border Visibility="{x:Bind ViewModel.IsError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="#FEE2E2"
                                        BorderBrush="#FCA5A5"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEA39;" FontSize="16" Foreground="#B91C1C" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                                   Foreground="#7F1D1D"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Button Command="{x:Bind ViewModel.InitiateCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Height="42"
                                        Visibility="{x:Bind ViewModel.IsNationalIdMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="16" Height="16" />
                                        <TextBlock Text="{x:Bind ViewModel.InitiateButtonText, Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE946;" FontSize="14"
                                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Waiting: QR (if present) + verification code + countdown -->
                        <StackPanel Spacing="20"
                                    HorizontalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsWaiting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Background="{ThemeResource EidAccentSubtleBrush}"
                                    BorderBrush="{ThemeResource EidAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE192;" FontSize="18" Foreground="{ThemeResource EidAccentBrush}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.WaitingTitle, Mode=OneWay}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource EidAccentBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.WaitingSubtitle, Mode=OneWay}"
                                                   Style="{StaticResource LabelTextBlock}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- QR image (Image.Source assigned in code-behind on QrPng change) -->
                            <Border BorderBrush="{ThemeResource EidCardStroke}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Background="White"
                                    HorizontalAlignment="Center">
                                <Image x:Name="QrImage"
                                       Width="220" Height="220"
                                       Stretch="Uniform" />
                            </Border>

                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.VerificationLabel, Mode=OneWay}"
                                           Style="{StaticResource LabelTextBlock}"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource CodeDigitBox}">
                                        <TextBlock Text="{x:Bind ViewModel.Digit1, Mode=OneWay}" Style="{StaticResource CodeDigitText}" />
                                    </Border>
                                    <Border Style="{StaticResource CodeDigitBox}">
                                        <TextBlock Text="{x:Bind ViewModel.Digit2, Mode=OneWay}" Style="{StaticResource CodeDigitText}" />
                                    </Border>
                                    <Border Style="{StaticResource CodeDigitBox}">
                                        <TextBlock Text="{x:Bind ViewModel.Digit3, Mode=OneWay}" Style="{StaticResource CodeDigitText}" />
                                    </Border>
                                    <Border Style="{StaticResource CodeDigitBox}">
                                        <TextBlock Text="{x:Bind ViewModel.Digit4, Mode=OneWay}" Style="{StaticResource CodeDigitText}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE121;" FontSize="14"
                                          Foreground="{x:Bind ViewModel.CountdownVariant, Mode=OneWay, Converter={StaticResource StatusVariantBrushConverter}}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.Countdown, Mode=OneWay}"
                                           FontFamily="Cascadia Code, Consolas, monospace"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.CountdownVariant, Mode=OneWay, Converter={StaticResource StatusVariantBrushConverter}}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Command="{x:Bind ViewModel.CancelCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Height="40">
                                <TextBlock Text="{x:Bind ViewModel.CancelLabel, Mode=OneWay}" />
                            </Button>
                        </StackPanel>

                        <!-- Success -->
                        <StackPanel Spacing="16"
                                    HorizontalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Background="#DCFCE7"
                                    Width="80" Height="80"
                                    CornerRadius="40"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE930;" FontSize="36" Foreground="#16A34A"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.SuccessTitle, Mode=OneWay}"
                                       Style="{StaticResource HeroTitleTextBlock}"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <ProgressRing IsActive="True" Width="16" Height="16" />
                                <TextBlock Text="{x:Bind ViewModel.SuccessSubtitle, Mode=OneWay}"
                                           Style="{StaticResource LabelTextBlock}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.SignedInName, Mode=OneWay}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource LabelTextBlock}">
                                    <Run x:Uid="Login_Result_NationalId" Text="National ID" />
                                    <Run Text=":" />
                                    <Run Text="{x:Bind ViewModel.SignedInNationalId, Mode=OneWay}" FontFamily="Cascadia Code, Consolas, monospace" />
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource LabelTextBlock}">
                                    <Run x:Uid="Login_Result_KycLevel" Text="KYC" />
                                    <Run Text=":" />
                                    <Run Text="{x:Bind ViewModel.SignedInKycLevel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <Button Command="{x:Bind ViewModel.SignOutCommand}" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SignOutLabel, Mode=OneWay}" />
                            </Button>
                        </StackPanel>

                        <!-- Try-again row when error -->
                        <Button Command="{x:Bind ViewModel.TryAgainCommand}"
                                Visibility="{x:Bind ViewModel.IsError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.TryAgainLabel, Mode=OneWay}" />
                        </Button>

                        <!-- Footer links -->
                        <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsIdleOrError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <HyperlinkButton Content="{x:Bind ViewModel.NewAccountLabel, Mode=OneWay}"
                                             NavigateUri="https://eidmongolia.mn/beta" />
                            <HyperlinkButton Content="{x:Bind ViewModel.HelpLabel, Mode=OneWay}"
                                             NavigateUri="https://eidmongolia.mn/help" />
                        </StackPanel>
                    </StackPanel>
                </controls:AppCard.Body>
            </controls:AppCard>
        </Grid>
    </ScrollViewer>
</Page>
