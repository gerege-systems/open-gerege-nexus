<!--
 Тохиргооны дэлгэц — аппын хүрээн ДОТОР амьдардаг UserControl.

 Өмнө нь энэ нь `ShowDialog()`-оор нээгддэг тусдаа Window байсан: modal тул
 ард нь байгаа ажлын муж хөлддөг, taskbar дээр хоёр дахь бичлэг гарч,
 kiosk/POS дээр бүтэн дэлгэцийн ард алга болдог байв. Одоо энэ нь MainWindow-
 ийн content host дотор webView-тэй ижил байранд солигдоно.

 Тусдаа цонх үлдээх ганц зөвшөөрөгдсөн зүйл бол popup: MessageBox, файл
 сонгох диалог — богино насалдаг, эцэг цонхондоо холбогддог.
-->
<UserControl x:Class="GeregeNexusNativeWin.SettingsPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{StaticResource EidSurfaceBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource EidCardBackground}" BorderBrush="{StaticResource EidCardStroke}" BorderThickness="0,0,1,0">
   <DockPanel><TextBlock DockPanel.Dock="Top" Text="DEVICE CONSOLE" FontWeight="Bold" FontSize="12" Foreground="{StaticResource EidAccentBrush}" Margin="18,22,18,14"/>
    <ListBox Name="sections" SelectionChanged="Section_Changed" Background="Transparent" BorderThickness="0" Padding="8" SelectedIndex="0">
     <ListBoxItem Content="⚙  Ерөнхий" Tag="general"/><ListBoxItem Content="◉  Холболт" Tag="connection"/>
     <ListBoxItem Content="▣  Принтер" Tag="printer"/><ListBoxItem Content="⌗  Сканнер" Tag="scanner"/>
     <ListBoxItem Content="⇄  Serial порт" Tag="serial"/><ListBoxItem Content="◆  Нууцлал" Tag="privacy"/>
     <ListBoxItem Content="▤  Төхөөрөмж" Tag="device"/>
     <ListBoxItem Name="drawerSection" Content="▰  Cash drawer" Tag="drawer"/>
     <ListBoxItem Content="↻  Шинэчлэлт" Tag="update"/><ListBoxItem Content="＋  Оношлогоо" Tag="diagnostics"/>
    </ListBox>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,28" MaxWidth="650" HorizontalAlignment="Left">
   <TextBlock Name="sectionTitle" Text="Ерөнхий" Style="{StaticResource PageTitleTextBlock}" Margin="0,0,0,16"/>
   <Border Background="{StaticResource EidCardBackground}"
           BorderBrush="{StaticResource EidCardStroke}" BorderThickness="1"
           CornerRadius="{StaticResource RadiusLg}" Padding="{StaticResource CardPadding}">
    <StackPanel>
   <StackPanel Name="generalPanel"><CheckBox Name="launchAtLogin" Content="Windows-д нэвтрэхэд автоматаар ажиллуулах" Margin="0,8"/><TextBlock Text="Хэл"/><ComboBox Name="language" Width="180" HorizontalAlignment="Left"><ComboBoxItem Content="mn"/><ComboBoxItem Content="en"/><ComboBoxItem Content="ru"/><ComboBoxItem Content="zh"/></ComboBox></StackPanel>
   <StackPanel Name="connectionPanel" Visibility="Collapsed"><TextBlock Text="Web endpoint"/><TextBox Name="webEndpoint"/><TextBlock Text="API endpoint" Margin="0,14,0,0"/><TextBox Name="apiEndpoint"/><Button Content="Холболт шалгах" Click="TestConnection_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="16,7"/></StackPanel>
   <StackPanel Name="printerPanel" Visibility="Collapsed"><TextBlock Text="Холболтын төрөл"/><ComboBox Name="printerTransport"><ComboBoxItem Content="USB"/><ComboBoxItem Content="Network"/><ComboBoxItem Content="Serial"/></ComboBox><TextBlock Text="IP / host" Margin="0,12,0,0"/><TextBox Name="printerHost"/><TextBlock Text="TCP port" Margin="0,12,0,0"/><TextBox Name="printerPort"/><TextBlock Text="Цаасны өргөн" Margin="0,12,0,0"/><ComboBox Name="paperWidth"><ComboBoxItem Content="58 mm"/><ComboBoxItem Content="80 mm"/></ComboBox><Button Content="Туршилтын баримт хэвлэх" Click="TestPrinter_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="16,7"/></StackPanel>
   <StackPanel Name="scannerPanel" Visibility="Collapsed"><TextBlock Text="Унших горим"/><ComboBox Name="scannerMode"><ComboBoxItem Content="Keyboard wedge"/><ComboBoxItem Content="Camera"/><ComboBoxItem Content="Vendor SDK"/></ComboBox><TextBlock Text="Төгсгөлийн тэмдэг" Margin="0,12,0,0"/><ComboBox Name="scannerSuffix"><ComboBoxItem Content="Enter"/><ComboBoxItem Content="Tab"/><ComboBoxItem Content="None"/></ComboBox><Button Content="Туршилтын код унших" Click="TestScanner_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="16,7"/></StackPanel>
   <StackPanel Name="serialPanel" Visibility="Collapsed"><TextBlock Text="COM port"/><TextBox Name="serialPort" ToolTip="Жишээ: COM3"/><TextBlock Text="Baud rate" Margin="0,12,0,0"/><ComboBox Name="baudRate"><ComboBoxItem Content="9600"/><ComboBoxItem Content="19200"/><ComboBoxItem Content="38400"/><ComboBoxItem Content="57600"/><ComboBoxItem Content="115200"/></ComboBox><Button Content="Порт нээж шалгах" Click="TestSerial_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="16,7"/></StackPanel>
   <StackPanel Name="privacyPanel" Visibility="Collapsed"><CheckBox Name="biometricLock" Content="Windows Hello түгжээ"/><TextBlock Text="Идэвхгүй үед түгжих (минут)" Margin="0,12,0,0"/><TextBox Name="idleMinutes"/><Button Content="Credential Manager цэвэрлэх…" Click="ClearCredentials_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="16,7"/></StackPanel>
   <StackPanel Name="devicePanel" Visibility="Collapsed"><TextBlock Text="Төхөөрөмжийн нэр"/><TextBox Name="deviceName"/><TextBlock Text="Байршил / site" Margin="0,12,0,0"/><TextBox Name="deviceSite"/><TextBlock Text="Нэг удаагийн enrollment code" Margin="0,12,0,0"/><TextBox Name="enrollmentCode" CharacterCasing="Upper"/><TextBlock Text="Device ID" Margin="0,12,0,0"/><TextBox Name="deviceId" IsReadOnly="True"/><TextBlock Text="Төлөв" Margin="0,12,0,0"/><TextBox Name="deviceStatus" IsReadOnly="True"/><StackPanel Orientation="Horizontal"><Button Content="Нэг удаагийн кодоор бүртгэх" Click="EnrollDevice_Click" Margin="0,18,8,0" Padding="16,7"/><Button Content="Device token шинэчлэх" Click="RotateToken_Click" Margin="0,18,0,0" Padding="16,7"/></StackPanel></StackPanel>
   <StackPanel Name="drawerPanel" Visibility="Collapsed"><TextBlock Text="Printer pulse (ms)"/><TextBox Name="drawerPulse"/><Button Content="Шургуулга нээх" Click="OpenDrawer_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="16,7"/></StackPanel>
   <StackPanel Name="updatePanel" Visibility="Collapsed"><TextBlock Text="Шинэчлэлийн суваг"/><ComboBox Name="updateChannel"><ComboBoxItem Content="Stable"/><ComboBoxItem Content="Pilot"/><ComboBoxItem Content="Internal"/></ComboBox><CheckBox Name="telemetry" Content="Оношлогооны мэдээлэл илгээх" Margin="0,16"/><Button Content="Шинэчлэлт шалгах" Click="CheckUpdates_Click" HorizontalAlignment="Left" Padding="16,7"/></StackPanel>
   <StackPanel Name="diagnosticsPanel" Visibility="Collapsed"><TextBlock Text="Shell contract     1.4"/><TextBlock Text="Runtime             .NET 8 + WebView2" Margin="0,8"/><TextBlock Name="osVersion"/><Button Content="Лог export хийх…" Click="ExportLogs_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="16,7"/></StackPanel>
    </StackPanel>
   </Border>
   <Border BorderBrush="{StaticResource EidCardStroke}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,18,0,0">
    <DockPanel>
     <TextBlock Name="status" Style="{StaticResource LabelTextBlock}" VerticalAlignment="Center"/>
     <Button DockPanel.Dock="Right" Content="Хадгалах" Click="Save_Click"
             Style="{StaticResource EidPrimaryButton}" Width="140" Height="40"/>
    </DockPanel>
   </Border>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
