<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Ported from gerege-line/eid/eid-platform-mn — desktop/windows-app,
        src/eIDMongolia.Client/Styles/Colors.xaml. The values are theirs
        exactly; the brand ramp is the same one their web app and their macOS
        app carry, so a change to it is a change in several repositories.

        What could not come across is the mechanism. Their app is WinUI 3 and
        this one is WPF, and `ResourceDictionary.ThemeDictionaries` does not
        exist here — WPF has no built-in notion of a light and a dark
        dictionary chosen for it. So the light set is the one that is live, and
        the dark set below it is a dictionary a theme service can merge over the
        top when this app grows one. Their values for both are kept either way,
        so that switch is a wiring job rather than a design job.
    -->

    <!-- Brand palette, mirrored from that platform's web globals.css. -->
    <Color x:Key="Brand50">#FFEEF4FF</Color>
    <Color x:Key="Brand100">#FFD8E6FF</Color>
    <Color x:Key="Brand200">#FFB3CCFF</Color>
    <Color x:Key="Brand300">#FF84A8FF</Color>
    <Color x:Key="Brand400">#FF5B8AFF</Color>
    <Color x:Key="Brand500">#FF3A6DFF</Color>
    <Color x:Key="Brand600">#FF2A5BD7</Color>
    <Color x:Key="Brand700">#FF1D47B3</Color>
    <Color x:Key="Brand800">#FF14358A</Color>
    <Color x:Key="Brand900">#FF0A2466</Color>
    <Color x:Key="Brand950">#FF001F5E</Color>

    <!-- Live set: their Light theme dictionary. -->
    <SolidColorBrush x:Key="EidAccentBrush"       Color="{StaticResource Brand500}" />
    <SolidColorBrush x:Key="EidAccentStrongBrush" Color="{StaticResource Brand700}" />
    <SolidColorBrush x:Key="EidAccentSubtleBrush" Color="{StaticResource Brand100}" />
    <SolidColorBrush x:Key="EidAccentMutedBrush"  Color="{StaticResource Brand50}" />
    <SolidColorBrush x:Key="EidSuccessBrush"      Color="#FF107C10" />
    <SolidColorBrush x:Key="EidWarningBrush"      Color="#FF9D5D00" />
    <SolidColorBrush x:Key="EidDangerBrush"       Color="#FFBA1A1A" />
    <SolidColorBrush x:Key="EidCardBackground"    Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="EidCardStroke"        Color="#FFE5E7EB" />
    <SolidColorBrush x:Key="EidSurfaceBrush"      Color="#FFF9F9FC" />
    <SolidColorBrush x:Key="EidMutedForeground"   Color="#FF6B7280" />
    <SolidColorBrush x:Key="EidTextPrimary"       Color="#FF0F172A" />

    <!-- Inline banner tints. Fixed in their app too, not theme-aware. -->
    <SolidColorBrush x:Key="EidBannerErrorBackground" Color="#FFFEE2E2" />
    <SolidColorBrush x:Key="EidBannerErrorStroke"     Color="#FFFCA5A5" />
    <SolidColorBrush x:Key="EidBannerErrorText"       Color="#FF7F1D1D" />

    <!--
        The sign-in panel's diagonal gradient, from their macOS LoginView:
        #091540 → #0E2060 at 45% → #1A3A8F, top-left to bottom-right. It is a
        brush rather than three colours because the panel is the only thing that
        uses it, and it is always dark — copy on it does not follow the theme.
    -->
    <LinearGradientBrush x:Key="EidHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF091540" Offset="0.0" />
        <GradientStop Color="#FF0E2060" Offset="0.45" />
        <GradientStop Color="#FF1A3A8F" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="EidHeroSubtitle" Color="#FF93C5FD" />
    <SolidColorBrush x:Key="EidHeroBody"     Color="#FF7CAEE8" />

    <!--
        Their Dark theme dictionary, held for the theme service this app does
        not have yet. Merging this over the set above is the whole switch.
    -->
    <ResourceDictionary x:Key="EidDarkOverlay">
        <SolidColorBrush x:Key="EidAccentBrush"       Color="#FF84A8FF" />
        <SolidColorBrush x:Key="EidAccentStrongBrush" Color="#FFB3CCFF" />
        <SolidColorBrush x:Key="EidAccentSubtleBrush" Color="#FF0A2466" />
        <SolidColorBrush x:Key="EidAccentMutedBrush"  Color="#FF001F5E" />
        <SolidColorBrush x:Key="EidSuccessBrush"      Color="#FF6FCF6F" />
        <SolidColorBrush x:Key="EidWarningBrush"      Color="#FFE8B66A" />
        <SolidColorBrush x:Key="EidDangerBrush"       Color="#FFFFB4AB" />
        <SolidColorBrush x:Key="EidCardBackground"    Color="#FF1F1F23" />
        <SolidColorBrush x:Key="EidCardStroke"        Color="#FF34343A" />
        <SolidColorBrush x:Key="EidSurfaceBrush"      Color="#FF0B0E12" />
        <SolidColorBrush x:Key="EidMutedForeground"   Color="#FF9CA3AF" />
        <SolidColorBrush x:Key="EidTextPrimary"       Color="#FFF8FAFC" />
    </ResourceDictionary>
</ResourceDictionary>
