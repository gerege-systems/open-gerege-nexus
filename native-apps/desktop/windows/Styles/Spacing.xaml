<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Ported from their Styles/Spacing.xaml, unchanged apart from the double
        declaration: `x:Double` is a WinUI intrinsic and WPF wants the CLR type,
        so the numbers arrive through a sys: alias instead.
    -->

    <!-- Spacing scale (4px base unit, 2 / 4 / 8 / 12 / 16 / 24 / 32 / 48). -->
    <sys:Double x:Key="SpaceXs">4</sys:Double>
    <sys:Double x:Key="SpaceSm">8</sys:Double>
    <sys:Double x:Key="SpaceMd">12</sys:Double>
    <sys:Double x:Key="SpaceLg">16</sys:Double>
    <sys:Double x:Key="SpaceXl">24</sys:Double>
    <sys:Double x:Key="Space2Xl">32</sys:Double>
    <sys:Double x:Key="Space3Xl">48</sys:Double>

    <Thickness x:Key="PagePadding">32,24,32,32</Thickness>
    <Thickness x:Key="SectionMargin">0,0,0,24</Thickness>
    <Thickness x:Key="CardPadding">24</Thickness>

    <!-- Corner radii — Fluent 11 style. -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <!-- The sign-in card's own corner, which their LoginView sets directly. -->
    <CornerRadius x:Key="RadiusCard">18</CornerRadius>
</ResourceDictionary>
