          }
        }
      }
    },
    "auth.eid.footer": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууц үг дамжуулахгүй · Баталгаажуулалт eID апп дотор хийгдэнэ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No password is sent · Approval happens inside the eID app"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم إرسال كلمة مرور · يتم التحقق داخل تطبيق eID"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "不发送密码 · 验证在 eID 应用内完成"
          }
        },
        "fr": {
          "stringUnit": {
