    "auth.view.lede": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "eID Mongolia апп дээр хүсэлтийг зөвшөөрөхөд Gerege Nexus болон холбогдсон SSO аппууд таны баталгаажсан session-ийг ашиглана."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve the request in the eID Mongolia app and Gerege Nexus — along with every connected SSO app — uses that verified session."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وافق على الطلب في تطبيق eID Mongolia وسيستخدم Gerege Nexus — جنبًا إلى جنب مع كل تطبيق SSO متصل — هذه الجلسة الموثقة."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在 eID Mongolia 应用中批准请求后，Gerege Nexus 以及所有连接的 SSO 应用都将使用您已验证的会话。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvez la demande dans l'application eID Mongolia et Gerege Nexus — ainsi que toutes les applications SSO connectées — utilisera cette session vérifiée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрите запрос в приложении eID Mongolia, и Gerege Nexus — вместе со всеми подключенными SSO приложениями — будет использовать вашу подтвержденную сессию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apruebe la solicitud en la aplicación eID Mongolia y Gerege Nexus, junto con todas las aplicaciones SSO conectadas, utilizarán esa sesión verificada."
          }
        }
      }
    },
    "auth.view.point_push": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
