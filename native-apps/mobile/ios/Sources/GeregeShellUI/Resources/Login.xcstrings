        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الهوية الرقمية الوطنية"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "国家数字身份"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IDENTITÉ NUMÉRIQUE NATIONALE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "НАЦИОНАЛЬНАЯ ЦИФРОВАЯ ИДЕНТИФИКАЦИЯ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IDENTIDAD DIGITAL NACIONAL"
          }
        }
      }
    },
