# Production environment for docker-compose.prod.yml.
#
# The deploy workflow writes /opt/open-gerege-nexus/.env on every rollout from
# GitHub secrets, so editing this by hand on the server is only needed for a
# manual deployment. Never commit the real file.

# Images published by CI to GHCR (lowercase repository path).
IMAGE_BACKEND=ghcr.io/gerege-systems/open-gerege-nexus/backend
IMAGE_FRONTEND=ghcr.io/gerege-systems/open-gerege-nexus/frontend
# Commit SHA of the release, or "latest".
IMAGE_TAG=latest

# Redis for cross-replica cache invalidation and shared rate limits. Defaults to
# the compose service; point it elsewhere to use an external Redis, or leave it
# empty to run without one (single replica only).
REDIS_URL=redis://redis:6379/0

# Database password used by postgres, migrate and the API.
POSTGRES_PASSWORD=

# Required in production: the built-in OAuth2 client is disabled without it.
SSO_DEFAULT_CLIENT_SECRET=

# Public origin — drives CORS, the OIDC issuer and the frontend API URL.
# Changing it is a coordinated change: DNS, the TLS certificate, and any client
# that pinned the previous issuer (openerp.gerege.mn, before the Gerege Nexus
# rebrand) all follow.
PUBLIC_ORIGIN=https://nexus.gerege.mn

# ------------------------------------------------------- A second stack, here
# Everything below is what keeps two deployments on one host from standing on
# each other. Leave them empty for the deployment that was here first: the
# defaults in docker-compose.prod.yml are exactly what nexus.gerege.mn runs.
#
# STACK prefixes the container names. POSTGRES_VOLUME names the disk the
# database lives on — the one variable here with teeth, because pointing it
# somewhere new brings Postgres up healthy on an empty data directory rather
# than failing. Read the note at the bottom of docker-compose.prod.yml before
# changing it on a stack that holds anything.
STACK=
POSTGRES_VOLUME=
CATALOG_CACHE_VOLUME=
# Where the published ports land on the host's loopback. nginx in front reads
# these; two stacks sharing one number is a rollout that takes the other one
# down.
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=
BACKEND_HOST_PORT=
FRONTEND_HOST_PORT=

# Device domain lines. Each native client talks to its own host; nginx points
# every one of them at the same frontend and the same API container, so the
# backend stays single while the origins are separate. They are appended to
# ALLOWED_ORIGINS, which drives both CORS and the CSRF origin check.
#
# Because each line serves /api/v1 under its own host, calls from inside a
# webview are same-origin: the session cookie is sent without any SameSite
# question arising, and no preflight is ever issued. A line left out here will
# fail every cookie authenticated write with "origin not allowed".
#
# Adding a line is a three-file change: this list,
# deploy/nginx/device-lines.nexus.gerege.mn.conf, and
# native-apps/shared/device_lines.json.
DEVICE_LINE_ORIGINS=https://mac.nexus.gerege.mn,https://win.nexus.gerege.mn,https://ios.nexus.gerege.mn,https://android.nexus.gerege.mn,https://kiosk.nexus.gerege.mn,https://pos.nexus.gerege.mn
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore
PUSH_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Sign this deployment's people in at another Gerege Nexus (or any OpenID
# Connect provider) instead of authenticating them here.
#
# Empty is the normal case: this deployment issues its own identities. Setting
# the issuer closes its password, eID and DAN sign-in endpoints and hands the
# login screen to the provider — signing out here signs the person out there
# and brings them back. In production the issuer must be HTTPS and the client id
# must be set, or the server refuses to start.
#
# What to register at the provider, and the rest of the variables, are in
# docs/SSO_FEDERATION.md.
SSO_CLIENT_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# The organisation a person the provider vouches for is created in on their
# first sign-in. Empty provisions nobody.
SSO_CLIENT_TENANT=

# ------------------------------------------------------------------------ Brand
# What this deployment calls itself. All empty means Gerege Nexus, which is what
# nexus.gerege.mn wants; a deployment standing up under another name fills these
# in and needs no image of its own to do it. Compose hands BRAND_NAME to both
# containers — see .env.example at the repository root for what each one is.
BRAND_NAME=
BRAND_SHORT_NAME=
BRAND_DESCRIPTION=
BRAND_LOGO_URL=
BRAND_THEME_COLOR=
# Wording, for a deployment that positions itself differently rather than
# merely calling itself something else. Put copy.json in the `brand/` directory
# beside the compose file — it is mounted read-only at /brand — and name it
# here. See brand/README.md.
BRAND_COPY_FILE=

# ------------------------------------------------------------- Operator console
# The hostname admin.nexus.gerege.mn is served from — leave it empty and the
# console does not exist on this deployment. Setting it is step 3 of
# docs/CONTROL_PLANE.md; steps 1 and 2 are nginx's vhost and its address
# allowlist, and doing this one without those puts the console on the internet.
# ------------------------------------------------------- Gerege Core directory
# The register lookups: an organisation by its registration number, a person by
# theirs. Used by the first-run wizard and by the organisation screen, so a
# deployment without it works — the fields are typed by hand and both screens
# say why. One long-lived read-only bearer; the console can rotate it at
# runtime as `core.api_token` without a restart.
GEREGE_CORE_TOKEN=

CONTROL_PLANE_HOST=

# Консолын нүүр хуудас юу уншихыг. Хоосон орхивол тухайн хэсэг нь "тохируулаагүй"
# гэж харагдана — тэг тоо харуулахгүй.
#
# Мониторингийн стек хостын loopback дээр нийтлэгддэг тул контейнерээс
# host.docker.internal-аар хандана (prod compose дотор extra_hosts бий).
PROMETHEUS_URL=http://host.docker.internal:9091
ALERTMANAGER_URL=http://host.docker.internal:9093
# Гүнзгий линкүүд нь операторын хөтчөөс нээгддэг тул энэ нь ил хаяг.
GRAFANA_URL=https://nexus.gerege.mn/grafana

# Deploy товч. Токен нь ЗӨВХӨН deploy workflow-д эрхтэй fine-grained байх ёстой;
# хоосон бол товч ажиллахгүй бөгөөд шалтгаанаа хэлнэ.
GITHUB_DEPLOY_TOKEN=
GITHUB_REPOSITORY=gerege-systems/open-gerege-nexus
GITHUB_DEPLOY_WORKFLOW=deploy.yml

# ---------------------------------------------------------------- Observability
#
# See docs/MONITORING.md. Empty is off for all of them, and off is the default.
# The monitoring stack itself has its own environment file
# (deploy/.env.monitoring.example) — these are the platform's half.

# Traces to the Tempo that deploy/docker-compose.monitoring.yml runs. It is on
# this stack's own Docker network, so the container name resolves.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
# Panic and error reporting over the Sentry protocol. GlitchTip is what
# deploy/docker-compose.glitchtip.yml runs; a hosted Sentry DSN works the same.
SENTRY_DSN=
# Usually the commit sha, set by the deploy workflow.
RELEASE_VERSION=

# Scheduled reports. Empty means schedules still run and are still recorded —
# with "delivery not configured" as the outcome, which the schedule screen
# shows — but nothing is sent.
#
# The design called for scheduled reports to go out through the hosted
# verification service. That service sends one thing, a verification link, and
# has no endpoint for a subject, a body or an attachment; so a scheduled report
# needs a mail transport of its own and SMTP is the one every deployment has an
# answer for. STARTTLS on 587; implicit TLS on 465 is not supported.
REPORT_SMTP_URL=
REPORT_MAIL_FROM=
# Only for a relay on the same host that speaks no TLS. Said explicitly rather
# than inferred from a missing password.
REPORT_SMTP_STARTTLS=true
