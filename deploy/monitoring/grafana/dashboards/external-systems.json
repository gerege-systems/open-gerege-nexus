  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Дуудлагын урсгал — системээр",
      "description": "ХУР, eID, ДАН, eSign HSM, Gemini, и-мэйл баталгаажуулалт. Огт харагдахгүй байгаа систем нь энэ суулгацад тохируулагдаагүй эсвэл ашиглагдаагүй.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nexus-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (system) (rate(external_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{system}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Алдааны хувь — системээр",
      "description": "Урсгал бага үед энэ тоо огцом үсэрдэг — нэг дуудлага, нэг алдаа нь 100%. Alert-ууд урсгалын нөхцөлтэй. Алдаагүй систем нь тэг шугам татна — өмнө нь бүхэлдээ хоосон харагддаг байсан, яг бүх зүйл эрүүл байх мөчид.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nexus-prometheus"
          },
          "editorMode": "code",
          "expr": "(sum by (system) (rate(external_request_duration_seconds_count{status=\"error\"}[$__rate_interval])) or sum by (system) (rate(external_request_duration_seconds_count[$__rate_interval])) * 0) / clamp_min(sum by (system) (rate(external_request_duration_seconds_count[$__rate_interval])), 0.001)",
          "legendFormat": "{{system}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
