    {
      "type": "timeseries",
      "title": "Контейнер бүрийн CPU",
      "description": " Контейнерийг ID-гаар нэрлэсэн, нэрээр нь биш. Docker 29 нь containerd snapshotter ашигладаг тул cAdvisor контейнерийн нэрийг Docker-оос уншиж чадахгүй — containerd-аас уншихад ID л ирдэг. Аль контейнер болохыг `docker ps --filter id=<эхний 12 тэмдэгт>`-ээр олно.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nexus-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (id) (rate(container_cpu_usage_seconds_total{id=~\"/system.slice/docker-.*\"}[$__rate_interval]))",
          "legendFormat": "{{id}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "noValue": "Хэмжигдэхгүй байна"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*docker-(.{12}).*",
            "renamePattern": "$1"
          }
        }
      ]
    },
