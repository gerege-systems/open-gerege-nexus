{
  "uid": "nexus-api-overview",
  "title": "Nexus — API тойм",
  "description": "RED (Rate, Errors, Duration) ба алдааны төсөв. Ямар нэг зүйл эвдэрсэн үү гэдэгт хариулах эхний дэлгэц.",
  "tags": [
    "nexus",
    "api",
    "red"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Хүсэлт/сек",
      "description": "RED-ийн Rate. Бүх зам, бүх статус.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexus-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nexus-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "rps",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Алдааны хувь (5xx)",
      "description": "RED-ийн Errors. 4xx энд ороогүй — татгалзсан нууц үг бол энэ үйлчилгээний доголдол биш.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexus-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nexus-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_duration_seconds_count[$__rate_interval])), 0.001)",
          "legendFormat": "error ratio",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.0144
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Үлдсэн алдааны төсөв (30 хоног)",
      "description": "99.9% SLO-ийн 0.1% төсвөөс хэдэн хувь нь үлдсэн. Сөрөг утга нь энэ сарын зорилт аль хэдийн биелэхгүй болсныг хэлнэ.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexus-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nexus-prometheus"
          },
          "editorMode": "code",
          "expr": "1 - (sum(increase(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[30d])) / clamp_min(sum(increase(http_server_request_duration_seconds_count[30d])), 1)) / 0.001",
          "legendFormat": "budget",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "p95 хариу",
      "description": "Урт poll-ыг хассан.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexus-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
