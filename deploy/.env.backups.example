# Environment for deploy/docker-compose.backups.yml.
#
# Copy to /opt/open-gerege-nexus/.env.backups on the server and fill in the
# three required values. Never commit the real file — it carries the store's
# root credentials, which are the credentials to every deployment's data.
#
#   docker compose -f deploy/docker-compose.backups.yml \
#     --env-file .env.backups up -d

# The store's administrator. Generate both with: openssl rand -base64 24
# These are not the credentials a deployment uses to push — each deployment gets
# its own key, scoped to its own bucket and unable to delete. See
# docs/OPERATIONS.md.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Where the store is reached from outside. MinIO builds redirects and presigned
# URLs from this, so a wrong value gives an endpoint that works for uploads and
# fails for everything else.
BACKUPS_PUBLIC_URL=https://backups.nexus.gerege.mn
